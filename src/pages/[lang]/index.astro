---
import BaseLayout from '../../layouts/BaseLayout.astro';
import LangNav from '../../components/LangNav.astro';
import LangFooter from '../../components/LangFooter.astro';
import AppCta from '../../components/AppCta.astro';
import StoreBadges from '../../components/StoreBadges.astro';
import ScanDemo from '../../components/ScanDemo.astro';
import Hero from '../../components/Hero.astro';
import StepList from '../../components/StepList.astro';
import Step from '../../components/Step.astro';
import CTASection from '../../components/CTASection.astro';
import type { Locale } from '../../i18n/config';
import { ui } from '../../i18n/ui';
import { getPageDef, pageHref, getHreflangLinks } from '../../i18n/pages';
import { G2_LISTING } from '../../data/g2AndOutreach';
import { SITE } from '../../data/content';

export function getStaticPaths() {
  return (['es', 'de', 'fr', 'it'] as const).map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Locale;
const home = getPageDef('home')!;
const content = home.content[lang];
const t = ui[lang];
const path = pageHref(home, lang);
const g2Url = G2_LISTING.profileUrl || SITE.social.g2;

const cafe = getPageDef('cafe-loyalty')!;
const pub = getPageDef('pub-loyalty')!;
const qr = getPageDef('qr-loyalty')!;
const pricing = getPageDef('pricing')!;
const how = getPageDef('how-it-works')!;
---

<BaseLayout
  title={content.metaTitle}
  description={content.description}
  path={path}
  lang={lang}
  hreflangLinks={getHreflangLinks(home)}
  faqs={content.faqs}
>
  <LangNav locale={lang} active="home" pageId="home" />

  <Hero variant="home">
    <div>
      <div class="hero__badge">
        <span class="hero__badge-dot"></span>
        Scan Perks
      </div>
      <h1 class="hero__title">{content.h1}</h1>
      <p class="hero__lead">
        {content.heroLine}
        <span>{content.bullets.slice(0, 3).join(' · ')}</span>
      </p>
      <div class="hero__actions">
        <AppCta class="btn btn--primary btn--lg">{t.cta.startTrial}</AppCta>
        <a href={g2Url} class="btn btn--glass btn--lg" rel="noopener noreferrer" target="_blank">
          {t.cta.leaveReview}
        </a>
      </div>
      <div class="hero__store-row">
        <StoreBadges showHint={false} centered={false} />
      </div>
    </div>
    <div class="hero__visual">
      <ScanDemo />
    </div>
  </Hero>

  <section class="section section--sm">
    <div class="container">
      <StepList>
        <Step n={1} title={t.cta.startTrial} description="app.scan-perks.com">
          <AppCta class="btn btn--primary">{t.nav.getStarted}</AppCta>
        </Step>
        <Step n={2} title={t.nav.how} description="QR → stamps → rewards">
          <a href={pageHref(how, lang)} class="btn btn--glass">{t.nav.how}</a>
        </Step>
        <Step n={3} title="G2" description={t.cta.leaveReview}>
          <a href={g2Url} class="btn btn--glass" rel="noopener noreferrer" target="_blank">{t.cta.leaveReview}</a>
        </Step>
      </StepList>
    </div>
  </section>

  <section class="section section--sm">
    <div class="container">
      <div class="venue-cta reveal">
        <a href={pageHref(cafe, lang)} class="venue-cta__card">{cafe.content[lang].h1.slice(0, 28)}</a>
        <a href={pageHref(pub, lang)} class="venue-cta__card">{pub.content[lang].h1.slice(0, 28)}</a>
        <a href={pageHref(qr, lang)} class="venue-cta__card">{qr.content[lang].h1.slice(0, 28)}</a>
        <a href={pageHref(pricing, lang)} class="venue-cta__card venue-cta__card--accent">{t.nav.pricing}</a>
      </div>
    </div>
  </section>

  <CTASection title={content.h1} description={content.heroLine}>
    <AppCta class="btn btn--primary btn--lg">{t.cta.startTrial}</AppCta>
    <a href={g2Url} class="btn btn--glass btn--lg" rel="noopener noreferrer" target="_blank">{t.cta.leaveReview}</a>
  </CTASection>

  <LangFooter locale={lang} />
</BaseLayout>

<style>
  .hero__store-row {
    margin-top: var(--space-5);
  }

  .hero__store-row :global(.store-badges) {
    justify-content: flex-start;
  }

  .venue-cta {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-3);
  }

  .venue-cta__card {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: var(--target-min);
    padding: var(--space-4) var(--space-3);
    border-radius: var(--radius-sm);
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    color: var(--color-text-secondary);
    font-weight: var(--weight-semibold);
    font-size: var(--text-sm);
    text-align: center;
    transition: border-color 0.2s, color 0.2s, transform 0.2s;
  }

  .venue-cta__card:hover {
    border-color: rgba(34, 211, 238, 0.45);
    color: var(--color-text);
    transform: translateY(-2px);
  }

  .venue-cta__card--accent {
    border-color: rgba(34, 211, 238, 0.4);
    color: var(--color-accent);
  }

  @media (max-width: 900px) {
    .venue-cta { grid-template-columns: 1fr 1fr; }
    .hero__store-row :global(.store-badges) { justify-content: center; }
  }
</style>
