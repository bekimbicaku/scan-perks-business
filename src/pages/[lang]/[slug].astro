---
import BaseLayout from '../../layouts/BaseLayout.astro';
import LangNav from '../../components/LangNav.astro';
import LangFooter from '../../components/LangFooter.astro';
import LocalizedLanding from '../../components/LocalizedLanding.astro';
import type { Locale } from '../../i18n/config';
import {
  allLocalizedPageDefs,
  findByLocaleSlug,
  getHreflangLinks,
  getPageDef,
  pageHref,
  PREFIXED_LOCALES,
} from '../../i18n/pages';
import { buildSoftwareApplicationSchema } from '../../seo/schema';

export function getStaticPaths() {
  const paths: { params: { lang: string; slug: string }; props: { pageId: string } }[] = [];
  for (const lang of PREFIXED_LOCALES) {
    for (const def of allLocalizedPageDefs) {
      if (def.id === 'home') continue;
      const slug = def.content[lang].slug;
      if (!slug) continue;
      paths.push({ params: { lang, slug }, props: { pageId: def.id } });
    }
  }
  return paths;
}

const lang = Astro.params.lang as Locale;
const slug = Astro.params.slug!;

const hit = findByLocaleSlug(lang, slug);
if (!hit) return Astro.redirect('/404');

const { def, content } = hit;
const path = pageHref(def, lang);
const home = getPageDef('home')!;
---

<BaseLayout
  title={content.metaTitle}
  description={content.description}
  path={path}
  lang={lang}
  hreflangLinks={getHreflangLinks(def)}
  keywords={content.keywords}
  faqs={content.faqs}
  breadcrumbs={[
    { name: 'Home', path: pageHref(home, lang) },
    { name: content.h1, path },
  ]}
  extraSchema={[buildSoftwareApplicationSchema()]}
>
  <LangNav
    locale={lang}
    active={def.id === 'features' ? 'features' : def.id === 'pricing' ? 'pricing' : ''}
    pageId={def.id}
  />
  <LocalizedLanding locale={lang} content={content} />
  <LangFooter locale={lang} />
</BaseLayout>
