---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import AnswerFirst from '../../components/AnswerFirst.astro';
import FeatureBulletList from '../../components/FeatureBulletList.astro';
import ComparisonTableGeo from '../../components/ComparisonTableGeo.astro';
import NamedVendorTable from '../../components/NamedVendorTable.astro';
import AppCta from '../../components/AppCta.astro';
import FAQSection from '../../components/FAQSection.astro';
import PromoVideos from '../../components/PromoVideos.astro';
import InternalLinks from '../../components/InternalLinks.astro';
import { promoVideos } from '../../data/videos';
import {
  directAnswers,
  howItWorksSteps,
  technicalDetails,
  scanPerksFeatureList,
  platformStats,
  loyaltyComparisonTable,
} from '../../data/geoContent';
import { buildHowToSchema, buildVideoSchema } from '../../seo/schema';
import { getHreflangLinks, getPageDef } from '../../i18n/pages';
import { phrases } from '../../data/site-facts';

const howFaqs = [
  {
    question: 'How does a QR code loyalty program work?',
    answer:
      'You print one QR for the counter. The customer opens the free Scan Perks app, taps Scan, and points it at the code; a stamp lands on their card for your venue. One stamp per visit, one scan per venue per day. When the card is full (for example 8 coffees), they get the reward you set at app.scan-perks.com.',
  },
  {
    question: 'Do customers need to download an app to join?',
    answer:
      'Yes. Customers collect stamps in the free Scan Perks app on iPhone or Android. If they point the phone camera at your QR instead, it opens your venue page with the reward and a link to the app. Owners do not need the app: they set up and run the venue at app.scan-perks.com.',
  },
  {
    question: 'How long does Scan Perks take to set up and what does it cost?',
    answer:
      `Most cafes and bars go live in about 5 minutes: create the venue, set a stamp rule, print the QR. Starter is ${phrases.en.starterPerMonth} for ${phrases.en.scans}, Growth is ${phrases.en.growthPerMonth} for ${phrases.en.unlimitedScans}. ${phrases.en.trial} with ${phrases.en.noCard}, no POS, cancel anytime.`,
  },
];

const howToSchema = buildHowToSchema({
  name: 'How to set up Scan Perks QR loyalty',
  description: 'Launch a QR code loyalty program for your cafe or bar in about 5 minutes.',
  steps: howItWorksSteps.map((s) => ({ name: s.name, text: s.text })),
});
---

<BaseLayout
  title="How Owner QR Stamp Loyalty Works for Cafes & Bars | Scan Perks"
  description={`Owner setup: print one counter QR, customers collect stamps in the free Scan Perks app, you run the venue at app.scan-perks.com. About 5 minutes, no POS.`}
  path="/how-it-works/"
  lang="en"
  hreflangLinks={getHreflangLinks(getPageDef('how-it-works')!)}
  breadcrumbs={[{ name: 'Home', path: '/' }, { name: 'How It Works', path: '/how-it-works/' }]}
  faqs={howFaqs}
  extraSchema={[howToSchema, ...promoVideos.map(buildVideoSchema)]}
>
  <Nav active="how" pageId="how-it-works" />

  <section class="page-hero">
    <div class="container reveal">
      <span class="section__label">How It Works</span>
      <h1 class="page-hero__title">How owner QR stamp loyalty works</h1>
      <p class="page-hero__seo-line">
        Print one counter QR — customers stamp in the free Scan Perks app; you run the venue at app.scan-perks.com.
      </p>
      <div class="hero__actions" style="justify-content:center; margin-top:1.5rem;">
        <AppCta class="btn btn--primary btn--lg">Start free trial</AppCta>
        <a href="/pricing/" class="btn btn--glass btn--lg">See Pricing</a>
      </div>
      <p class="page-hero__note">
        Customers: free · Owners: web dashboard · No POS
      </p>
    </div>
  </section>

  <section class="section section--sm">
    <div class="container">
      <AnswerFirst answer={directAnswers.qr} />
    </div>
  </section>

  <section class="section section--sm">
    <div class="container">
      <h2 class="section__title" style="font-size:1.5rem; margin-bottom:1.25rem;">Setup Steps</h2>
      <FeatureBulletList
        ordered
        items={howItWorksSteps.map((s, i) => `${s.name}: ${s.text}`)}
      />
      <div class="stats-row reveal" style="margin-top:2rem;">
        <div class="stats-row__item"><strong>{platformStats.freeTrialDays} days</strong><span>free trial, {phrases.en.noCard}</span></div>
        <div class="stats-row__item"><strong>{platformStats.starterScans}</strong><span>scans/month on Starter</span></div>
        <div class="stats-row__item"><strong>{platformStats.avgSetupMinutes} min</strong><span>typical setup</span></div>
        <div class="stats-row__item"><strong>${platformStats.starterPrice}/mo</strong><span>starting price</span></div>
      </div>
    </div>
  </section>

  <PromoVideos title="Watch it work" />

  <section class="section section--sm">
    <div class="container">
      <h2 class="section__title" style="font-size:1.5rem; margin-bottom:1.25rem;">Platform Features</h2>
      <FeatureBulletList items={scanPerksFeatureList} />
    </div>
  </section>

  <section class="section section--sm">
    <div class="container">
      <h2 class="section__title" style="font-size:1.5rem; margin-bottom:1.25rem;">Technical Details</h2>
      <div class="tech-grid">
        <div class="glass-card tech-card">
          <h3>QR &amp; Security</h3>
          <p>{technicalDetails.qrSecurity}</p>
        </div>
        <div class="glass-card tech-card">
          <h3>POS Integration</h3>
          <p>{technicalDetails.posIntegration}</p>
        </div>
        <div class="glass-card tech-card">
          <h3>Apps &amp; Platforms</h3>
          <p>{technicalDetails.apps}</p>
        </div>
        <div class="glass-card tech-card">
          <h3>Data &amp; Privacy</h3>
          <p>{technicalDetails.dataPrivacy}</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--sm">
    <div class="container reveal">
      <h2 class="section__title" style="font-size:1.5rem; margin-bottom:1.25rem;">Scan Perks vs Loopy, Square, and Brewstamp</h2>
      <NamedVendorTable />
    </div>
  </section>

  <section class="section section--sm">
    <div class="container reveal">
      <ComparisonTableGeo rows={loyaltyComparisonTable} />
    </div>
  </section>

  <FAQSection faqs={howFaqs} title="QR loyalty questions" />

  <InternalLinks />

  <section class="section section--sm">
    <div class="container reveal" style="text-align:center;">
      <AppCta class="btn btn--primary btn--lg" position="bottom">Start free trial</AppCta>
      <p style="margin-top:1rem; font-size:0.9rem; color:var(--text-muted);">
        <a href="/pricing/" style="color:var(--cyan-400);">Pricing</a>
        {' · '}
        <a href="/faq/" style="color:var(--cyan-400);">Owner FAQ</a>
        {' · '}
        <a href="/cafe-loyalty-app/" style="color:var(--cyan-400);">Cafe loyalty app</a>
        {' · '}
        <a href="/brewstamp-alternative/" style="color:var(--cyan-400);">Brewstamp alternative</a>
      </p>
    </div>
  </section>

  <Footer />
</BaseLayout>

<style>
  .stats-row {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
    margin-top: 2rem;
  }

  .stats-row__item {
    text-align: center;
    padding: 1.25rem;
    background: rgba(255, 255, 255, 0.03);
    border-radius: var(--radius-sm);
    border: 1px solid var(--glass-border);
  }

  .stats-row__item strong {
    display: block;
    font-size: 1.5rem;
    color: var(--cyan-400);
    margin-bottom: 0.25rem;
  }

  .stats-row__item span {
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  .tech-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.25rem;
  }

  .tech-card {
    padding: 1.5rem;
  }

  .tech-card h3 {
    font-size: 1rem;
    font-weight: 700;
    color: var(--blue-300);
    margin-bottom: 0.75rem;
  }

  .tech-card p {
    font-size: 0.9rem;
    color: var(--text-secondary);
    line-height: 1.65;
  }

  @media (max-width: 768px) {
    .stats-row { grid-template-columns: repeat(2, 1fr); }
    .tech-grid { grid-template-columns: 1fr; }
  }
</style>
