---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import AnswerFirst from '../../components/AnswerFirst.astro';
import FeatureBulletList from '../../components/FeatureBulletList.astro';
import ComparisonTableGeo from '../../components/ComparisonTableGeo.astro';
import CaseStudies from '../../components/CaseStudies.astro';
import AppCta from '../../components/AppCta.astro';
import {
  directAnswers,
  howItWorksSteps,
  technicalDetails,
  scanPerksFeatureList,
  platformStats,
  loyaltyComparisonTable,
  caseStudies,
} from '../../data/geoContent';
import { buildSoftwareApplicationSchema, buildHowToSchema } from '../../seo/schema';

const howToSchema = buildHowToSchema({
  name: 'How to set up Scan Perks QR loyalty',
  description: 'Launch a QR code loyalty program for your cafe or bar in about 5 minutes.',
  steps: howItWorksSteps.map((s) => ({ name: s.name, text: s.text })),
});
---

<BaseLayout
  title="How Scan Perks Works — QR Loyalty Setup in 5 Minutes"
  description="Technical overview: QR loyalty setup, customer iOS/Android apps, no POS integration, data security. 500+ venues, $10/mo, 14-day free trial."
  path="/how-it-works/"
  keywords={['how qr loyalty works', 'cafe loyalty setup', 'qr code loyalty program setup']}
  breadcrumbs={[{ name: 'Home', path: '/' }, { name: 'How It Works', path: '/how-it-works/' }]}
  extraSchema={[buildSoftwareApplicationSchema(), howToSchema]}
>
  <Nav active="how" />

  <section class="page-hero">
    <div class="container reveal">
      <span class="section__label">How It Works</span>
      <h1 class="page-hero__title">QR Loyalty Setup — Technical Overview</h1>
      <p class="page-hero__desc">
        How Scan Perks works for independent cafes, bars, and restaurants: QR scanning, mobile apps, and owner dashboard — no POS integration.
      </p>
    </div>
  </section>

  <section class="section section--sm">
    <div class="container">
      <AnswerFirst answer={directAnswers.qr} />

      <div class="stats-row reveal">
        <div class="stats-row__item"><strong>{platformStats.venues}</strong><span>venues</span></div>
        <div class="stats-row__item"><strong>{platformStats.activeMembers}</strong><span>loyalty members</span></div>
        <div class="stats-row__item"><strong>{platformStats.avgSetupMinutes} min</strong><span>typical setup</span></div>
        <div class="stats-row__item"><strong>${platformStats.starterPrice}/mo</strong><span>starting price</span></div>
      </div>
    </div>
  </section>

  <section class="section section--sm">
    <div class="container">
      <h2 class="section__title" style="font-size:1.5rem; margin-bottom:1.25rem;">Setup Steps</h2>
      <FeatureBulletList
        ordered
        items={howItWorksSteps.map((s, i) => `${s.name}: ${s.text}`)}
      />
    </div>
  </section>

  <section class="section section--sm">
    <div class="container">
      <h2 class="section__title" style="font-size:1.5rem; margin-bottom:1.25rem;">Platform Features</h2>
      <FeatureBulletList items={scanPerksFeatureList} />
    </div>
  </section>

  <section class="section section--sm">
    <div class="container">
      <h2 class="section__title" style="font-size:1.5rem; margin-bottom:1.25rem;">Technical Details</h2>
      <div class="tech-grid">
        <div class="glass-card tech-card">
          <h3>QR &amp; Security</h3>
          <p>{technicalDetails.qrSecurity}</p>
        </div>
        <div class="glass-card tech-card">
          <h3>POS Integration</h3>
          <p>{technicalDetails.posIntegration}</p>
        </div>
        <div class="glass-card tech-card">
          <h3>Apps &amp; Platforms</h3>
          <p>{technicalDetails.apps}</p>
        </div>
        <div class="glass-card tech-card">
          <h3>Data &amp; Privacy</h3>
          <p>{technicalDetails.dataPrivacy}</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--sm">
    <div class="container reveal">
      <ComparisonTableGeo rows={loyaltyComparisonTable} />
    </div>
  </section>

  <section class="section section--sm">
    <div class="container">
      <CaseStudies studies={caseStudies} />
    </div>
  </section>

  <section class="section section--sm">
    <div class="container reveal" style="text-align:center;">
      <AppCta class="btn btn--primary btn--lg">Start at app.scan-perks.com</AppCta>
    </div>
  </section>

  <Footer />
</BaseLayout>

<style>
  .stats-row {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
    margin-top: 2rem;
  }

  .stats-row__item {
    text-align: center;
    padding: 1.25rem;
    background: rgba(255, 255, 255, 0.03);
    border-radius: var(--radius-sm);
    border: 1px solid var(--glass-border);
  }

  .stats-row__item strong {
    display: block;
    font-size: 1.5rem;
    color: var(--cyan-400);
    margin-bottom: 0.25rem;
  }

  .stats-row__item span {
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  .tech-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.25rem;
  }

  .tech-card {
    padding: 1.5rem;
  }

  .tech-card h3 {
    font-size: 1rem;
    font-weight: 700;
    color: var(--blue-300);
    margin-bottom: 0.75rem;
  }

  .tech-card p {
    font-size: 0.9rem;
    color: var(--text-secondary);
    line-height: 1.65;
  }

  @media (max-width: 768px) {
    .stats-row { grid-template-columns: repeat(2, 1fr); }
    .tech-grid { grid-template-columns: 1fr; }
  }
</style>
