---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import AnswerFirst from '../../components/AnswerFirst.astro';
import FeatureBulletList from '../../components/FeatureBulletList.astro';
import ComparisonTableGeo from '../../components/ComparisonTableGeo.astro';
import NamedVendorTable from '../../components/NamedVendorTable.astro';
import CaseStudies from '../../components/CaseStudies.astro';
import AppCta from '../../components/AppCta.astro';
import FAQSection from '../../components/FAQSection.astro';
import PromoVideos from '../../components/PromoVideos.astro';
import { promoVideos } from '../../data/videos';
import {
  directAnswers,
  howItWorksSteps,
  technicalDetails,
  scanPerksFeatureList,
  platformStats,
  loyaltyComparisonTable,
  caseStudies,
} from '../../data/geoContent';
import { buildSoftwareApplicationSchema, buildHowToSchema, buildVideoSchema } from '../../seo/schema';
import { getHreflangLinks, getPageDef } from '../../i18n/pages';

const howFaqs = [
  {
    question: 'How does a QR code loyalty program work?',
    answer:
      'You print a QR for the counter. The customer scans it with their phone camera and a digital stamp card opens — no download. Each visit adds a stamp. When they hit your rule (for example 9 coffees), staff redeem the free drink in the dashboard at app.scan-perks.com.',
  },
  {
    question: 'Do customers need to download an app to join?',
    answer:
      'No. The phone camera is enough. An iOS or Android app is optional for regulars who want a shortcut. Owners always use app.scan-perks.com.',
  },
  {
    question: 'How long does Scan Perks take to set up and what does it cost?',
    answer:
      'Most cafes and bars go live in about 5 minutes: create the venue, set a stamp rule, print the QR. Starter is $10/month (about £8) for 200 members, Growth is $15/month. 14-day free trial, no POS, cancel anytime.',
  },
];

const howToSchema = buildHowToSchema({
  name: 'How to set up Scan Perks QR loyalty',
  description: 'Launch a QR code loyalty program for your cafe or bar in about 5 minutes.',
  steps: howItWorksSteps.map((s) => ({ name: s.name, text: s.text })),
});
---

<BaseLayout
  title="How QR Code Loyalty Works — No Download, $10/mo"
  description="Customers scan your counter QR with their phone camera — no download. Stamps, free drinks, owner dashboard. $10/mo, 14-day free trial, no POS."
  path="/how-it-works/"
  lang="en"
  hreflangLinks={getHreflangLinks(getPageDef('how-it-works')!)}
  keywords={['how qr loyalty works', 'cafe loyalty setup', 'qr code loyalty program setup']}
  breadcrumbs={[{ name: 'Home', path: '/' }, { name: 'How It Works', path: '/how-it-works/' }]}
  faqs={howFaqs}
  extraSchema={[buildSoftwareApplicationSchema(), howToSchema, ...promoVideos.map(buildVideoSchema)]}
>
  <Nav active="how" pageId="how-it-works" />

  <section class="page-hero">
    <div class="container reveal">
      <span class="section__label">How It Works</span>
      <h1 class="page-hero__title">How a QR loyalty program works</h1>
      <p class="page-hero__desc">
        Print a counter QR. Customers scan with their phone camera — no download. Stamps land on their phone. You track visits from app.scan-perks.com. About 5 minutes, from $10/month.
      </p>
      <div class="hero__actions" style="justify-content:center; margin-top:1.5rem;">
        <AppCta class="btn btn--primary btn--lg">Start 14-day free trial</AppCta>
        <a href="/pricing/" class="btn btn--glass btn--lg">See Pricing</a>
      </div>
    </div>
  </section>

  <section class="section section--sm">
    <div class="container">
      <AnswerFirst answer={directAnswers.qr} />

      <div class="stats-row reveal">
        <div class="stats-row__item"><strong>{platformStats.venues}</strong><span>venues</span></div>
        <div class="stats-row__item"><strong>{platformStats.activeMembers}</strong><span>loyalty members</span></div>
        <div class="stats-row__item"><strong>{platformStats.avgSetupMinutes} min</strong><span>typical setup</span></div>
        <div class="stats-row__item"><strong>${platformStats.starterPrice}/mo</strong><span>starting price</span></div>
      </div>
    </div>
  </section>

  <section class="section section--sm">
    <div class="container">
      <h2 class="section__title" style="font-size:1.5rem; margin-bottom:1.25rem;">Setup Steps</h2>
      <FeatureBulletList
        ordered
        items={howItWorksSteps.map((s, i) => `${s.name}: ${s.text}`)}
      />
    </div>
  </section>

  <PromoVideos title="Watch it work" />

  <section class="section section--sm">
    <div class="container">
      <h2 class="section__title" style="font-size:1.5rem; margin-bottom:1.25rem;">Platform Features</h2>
      <FeatureBulletList items={scanPerksFeatureList} />
    </div>
  </section>

  <section class="section section--sm">
    <div class="container">
      <h2 class="section__title" style="font-size:1.5rem; margin-bottom:1.25rem;">Technical Details</h2>
      <div class="tech-grid">
        <div class="glass-card tech-card">
          <h3>QR &amp; Security</h3>
          <p>{technicalDetails.qrSecurity}</p>
        </div>
        <div class="glass-card tech-card">
          <h3>POS Integration</h3>
          <p>{technicalDetails.posIntegration}</p>
        </div>
        <div class="glass-card tech-card">
          <h3>Apps &amp; Platforms</h3>
          <p>{technicalDetails.apps}</p>
        </div>
        <div class="glass-card tech-card">
          <h3>Data &amp; Privacy</h3>
          <p>{technicalDetails.dataPrivacy}</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--sm">
    <div class="container reveal">
      <h2 class="section__title" style="font-size:1.5rem; margin-bottom:1.25rem;">Scan Perks vs Loopy, Square, and Brewstamp</h2>
      <NamedVendorTable />
    </div>
  </section>

  <section class="section section--sm">
    <div class="container reveal">
      <ComparisonTableGeo rows={loyaltyComparisonTable} />
    </div>
  </section>

  <section class="section section--sm">
    <div class="container">
      <CaseStudies studies={caseStudies} />
    </div>
  </section>

  <FAQSection faqs={howFaqs} title="QR loyalty questions" />

  <section class="section section--sm">
    <div class="container reveal" style="text-align:center;">
      <AppCta class="btn btn--primary btn--lg">Start 14-day free trial</AppCta>
    </div>
  </section>

  <Footer />
</BaseLayout>

<style>
  .stats-row {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
    margin-top: 2rem;
  }

  .stats-row__item {
    text-align: center;
    padding: 1.25rem;
    background: rgba(255, 255, 255, 0.03);
    border-radius: var(--radius-sm);
    border: 1px solid var(--glass-border);
  }

  .stats-row__item strong {
    display: block;
    font-size: 1.5rem;
    color: var(--cyan-400);
    margin-bottom: 0.25rem;
  }

  .stats-row__item span {
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  .tech-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.25rem;
  }

  .tech-card {
    padding: 1.5rem;
  }

  .tech-card h3 {
    font-size: 1rem;
    font-weight: 700;
    color: var(--blue-300);
    margin-bottom: 0.75rem;
  }

  .tech-card p {
    font-size: 0.9rem;
    color: var(--text-secondary);
    line-height: 1.65;
  }

  @media (max-width: 768px) {
    .stats-row { grid-template-columns: repeat(2, 1fr); }
    .tech-grid { grid-template-columns: 1fr; }
  }
</style>
