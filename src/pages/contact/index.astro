---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import StoreBadges from '../../components/StoreBadges.astro';
import { SITE } from '../../data/content';
import { getHreflangLinks, getPageDef } from '../../i18n/pages';
---

<BaseLayout
  title="Contact Scan Perks — Business Loyalty Support"
  description="Contact Scan Perks for help with your business loyalty program. Email hello@scan-perks.com or download the app to get started."
  path="/contact/"
  lang="en"
  hreflangLinks={getHreflangLinks(getPageDef('contact')!)}
  breadcrumbs={[{ name: 'Home', path: '/' }, { name: 'Contact', path: '/contact/' }]}
>
  <Nav active="contact" pageId="contact" />

  <section class="page-hero">
    <div class="container reveal">
      <span class="section__label">Contact</span>
      <h1 class="page-hero__title">Get in <span class="gradient-text">Touch</span></h1>
      <p class="page-hero__desc">Questions about your business loyalty program? We're here to help.</p>
    </div>
  </section>

  <section class="section section--sm">
    <div class="container">
      <div class="contact-grid">
        <div class="reveal">
          <div class="contact-info__item">
            <div class="contact-info__icon">📧</div>
            <div>
              <div class="contact-info__label">Email</div>
              <div class="contact-info__value"><a href={`mailto:${SITE.email}`}>{SITE.email}</a></div>
            </div>
          </div>
          <div class="contact-info__item">
            <div class="contact-info__icon">📱</div>
            <div>
              <div class="contact-info__label">Get Started</div>
              <div class="contact-info__value">
                Open <a href={SITE.appWebUrl}>{SITE.appWebUrl.replace('https://', '')}</a> to launch your loyalty program
              </div>
            </div>
          </div>
          <StoreBadges showHint={false} centered={false} />
        </div>
        <div class="glass-card contact-form reveal">
          <h2 style="font-size:1.25rem; font-weight:700; margin-bottom:1.5rem;">Send a Message</h2>
          <p id="form-status" class="form-status" role="status" aria-live="polite"></p>
          <form
            id="contact-form"
            data-endpoint={`https://formsubmit.co/ajax/${SITE.email}`}
            novalidate
          >
            <input type="hidden" name="_subject" value="Scan Perks — new contact form message" />
            <input type="hidden" name="_template" value="table" />
            <input type="hidden" name="_captcha" value="false" />
            <input type="text" name="_honey" class="form-honey" tabindex="-1" autocomplete="off" aria-hidden="true" />
            <div class="form-row">
              <div class="form-group">
                <label for="name">Name</label>
                <input type="text" id="name" name="name" required autocomplete="name" />
              </div>
              <div class="form-group">
                <label for="email">Email</label>
                <input type="email" id="email" name="email" required autocomplete="email" />
              </div>
            </div>
            <div class="form-group">
              <label for="message">Message</label>
              <textarea id="message" name="message" required rows="5"></textarea>
            </div>
            <button type="submit" class="btn btn--primary" style="width:100%;">Send Message</button>
            <p class="form-fallback">
              Or email us directly: <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
            </p>
          </form>
        </div>
      </div>
    </div>
  </section>

  <Footer />
</BaseLayout>
