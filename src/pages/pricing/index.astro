---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import FAQSection from '../../components/FAQSection.astro';
import AppCta from '../../components/AppCta.astro';
import InternalLinks from '../../components/InternalLinks.astro';
import AnswerFirst from '../../components/AnswerFirst.astro';
import ComparisonTableGeo from '../../components/ComparisonTableGeo.astro';
import { pricingSeo } from '../../data/pageSeo';
import { pricingFaqs } from '../../data/conversationalFaqs';
import { loyaltyComparisonTable, competitorComparisonIntro } from '../../data/geoContent';
import { buildSoftwareApplicationSchema } from '../../seo/schema';
import { getHreflangLinks, getPageDef } from '../../i18n/pages';
---

<BaseLayout
  title={pricingSeo.title}
  description={pricingSeo.description}
  path="/pricing/"
  lang="en"
  hreflangLinks={getHreflangLinks(getPageDef('pricing')!)}
  keywords={['loyalty program pricing', 'cafe loyalty app cost', 'bar loyalty program price', 'affordable loyalty app']}
  faqs={pricingFaqs}
  breadcrumbs={[{ name: 'Home', path: '/' }, { name: 'Pricing', path: '/pricing/' }]}
  extraSchema={[buildSoftwareApplicationSchema()]}
>
  <Nav active="pricing" pageId="pricing" />

  <section class="page-hero">
    <div class="container reveal">
      <span class="section__label">Pricing</span>
      <h1 class="page-hero__title">{pricingSeo.h1}</h1>
      <p class="page-hero__desc">{pricingSeo.heroDesc}</p>
      <div class="hero__actions" style="justify-content:center; margin-top:1.5rem;">
        <AppCta class="btn btn--primary btn--lg" position="hero">Start 14-day free trial</AppCta>
        <a href="/how-it-works/" class="btn btn--glass btn--lg">See How It Works</a>
      </div>
    </div>
  </section>

  <section class="section section--sm">
    <div class="container">
      <AnswerFirst answer={pricingSeo.directAnswer} />
    </div>
  </section>

  <section class="section section--sm">
    <div class="container">
      <div class="pricing-grid">
        <div class="glass-card pricing-card reveal">
          <div class="pricing-card__name">Starter</div>
          <div class="pricing-card__price">$10<span>/month</span></div>
          <p class="pricing-card__desc">Small cafes, bars, and coffee shops — up to 500 scans a month.</p>
          <ul class="pricing-card__features">
            <li>One counter QR and digital stamp card</li>
            <li>500 scans a month</li>
            <li>Welcome stamp, birthday treats, happy hour</li>
            <li>Offers pushed to members</li>
            <li>Basic analytics</li>
            <li>Listed in the app's Nearby list</li>
          </ul>
          <AppCta class="btn btn--glass" style="width:100%;" position="starter">Start 14-Day Free Trial</AppCta>
        </div>
        <div class="glass-card pricing-card pricing-card--featured reveal">
          <div class="pricing-card__name">Growth</div>
          <div class="pricing-card__price">$15<span>/month</span></div>
          <p class="pricing-card__desc">Busy venues — unlimited scans.</p>
          <ul class="pricing-card__features">
            <li>Everything in Starter</li>
            <li>Unlimited scans</li>
            <li>Advanced analytics</li>
            <li>Priority support</li>
          </ul>
          <AppCta class="btn btn--primary" style="width:100%;" position="growth">Start 14-Day Free Trial</AppCta>
        </div>
      </div>
      <p style="text-align:center; margin-top:1.5rem; color:var(--text-muted); font-size:0.9rem;">
        vs $200+/mo enterprise loyalty — <a href="/features/" style="color:var(--cyan-400);">compare features</a>
      </p>
    </div>
  </section>

  <InternalLinks />

  <section class="section section--sm">
    <div class="container reveal">
      <h2 class="section__title" style="font-size:1.35rem; margin-bottom:1rem;">Price Comparison</h2>
      <ComparisonTableGeo rows={loyaltyComparisonTable} intro={competitorComparisonIntro} />
    </div>
  </section>

  <FAQSection faqs={pricingFaqs} title="Pricing FAQ" />
  <Footer />
</BaseLayout>
