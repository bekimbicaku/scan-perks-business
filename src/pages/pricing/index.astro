---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import FAQSection from '../../components/FAQSection.astro';
import AppCta from '../../components/AppCta.astro';
import InternalLinks from '../../components/InternalLinks.astro';
import AnswerFirst from '../../components/AnswerFirst.astro';
import ComparisonTableGeo from '../../components/ComparisonTableGeo.astro';
import Hero from '../../components/Hero.astro';
import PricingCards from '../../components/PricingCards.astro';
import { pricingSeo } from '../../data/pageSeo';
import { pricingFaqs } from '../../data/conversationalFaqs';
import { loyaltyComparisonTable, competitorComparisonIntro } from '../../data/geoContent';
import { getHreflangLinks, getPageDef } from '../../i18n/pages';
import { phrases } from '../../data/site-facts';
---

<BaseLayout
  title={pricingSeo.title}
  description={pricingSeo.description}
  path="/pricing/"
  lang="en"
  hreflangLinks={getHreflangLinks(getPageDef('pricing')!)}
  faqs={pricingFaqs}
  breadcrumbs={[{ name: 'Home', path: '/' }, { name: 'Pricing', path: '/pricing/' }]}
>
  <Nav active="pricing" pageId="pricing" />

  <Hero>
    <span class="section__label">Pricing</span>
    <h1 class="page-hero__title">{pricingSeo.h1}</h1>
    <p class="page-hero__desc">{pricingSeo.heroDesc}</p>
    <div class="hero__actions hero__actions--center">
      <AppCta class="btn btn--primary btn--lg" position="hero">Start free trial</AppCta>
      <a href="/how-it-works/" class="btn btn--glass btn--lg">See How It Works</a>
    </div>
  </Hero>

  <section class="section section--sm">
    <div class="container">
      <AnswerFirst answer={pricingSeo.directAnswer} />
    </div>
  </section>

  <section class="section section--sm">
    <div class="container">
      <PricingCards />
      <p style="text-align:center; margin-top:1.25rem; color:var(--text-secondary); font-weight:600;">{phrases.en.noCardNeeded}</p>
      <p style="text-align:center; margin-top:1.5rem; color:var(--text-muted); font-size:0.9rem;">
        vs $200+/mo enterprise loyalty — <a href="/features/" style="color:var(--cyan-400);">compare features</a>
      </p>
    </div>
  </section>

  <InternalLinks />

  <section class="section section--sm">
    <div class="container reveal">
      <h2 class="section__title" style="font-size:1.35rem; margin-bottom:1rem;">Price Comparison</h2>
      <ComparisonTableGeo rows={loyaltyComparisonTable} intro={competitorComparisonIntro} />
    </div>
  </section>

  <FAQSection faqs={pricingFaqs} title="Pricing FAQ" />
  <Footer />
</BaseLayout>
