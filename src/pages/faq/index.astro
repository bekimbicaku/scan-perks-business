---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import AnswerFirst from '../../components/AnswerFirst.astro';
import ComparisonTableGeo from '../../components/ComparisonTableGeo.astro';
import AppCta from '../../components/AppCta.astro';
import {
  masterGeoFaqs,
  directAnswers,
  loyaltyComparisonTable,
  competitorComparisonIntro,
} from '../../data/geoContent';
import { getHreflangLinks, getPageDef } from '../../i18n/pages';
import { phrases } from '../../data/site-facts';

const faqs = masterGeoFaqs.map(({ question, answer }) => ({ question, answer }));
const categories = [
  { id: 'coffee', label: 'Coffee & Cafe Loyalty' },
  { id: 'mobile', label: 'Mobile Apps & Rewards' },
  { id: 'qr', label: 'QR Loyalty' },
  { id: 'comparison', label: 'Comparisons' },
];
---

<BaseLayout
  title={`Best Loyalty Program for Cafes — ${phrases.en.starterPerMo}, No POS`}
  description={`Best loyalty program for cafes, for owners: a stamp card from ${phrases.en.starterPerMo}, no POS, ${phrases.en.trialShort}. Square Plus, Loopy and Brewstamp prices included.`}
  path="/faq/"
  lang="en"
  hreflangLinks={getHreflangLinks(getPageDef('faq')!)}
  faqs={faqs}
  breadcrumbs={[{ name: 'Home', path: '/' }, { name: 'FAQ', path: '/faq/' }]}
>
  <Nav active="faq" pageId="faq" />

  <section class="page-hero">
    <div class="container reveal">
      <span class="section__label">FAQ</span>
      <h1 class="page-hero__title">Best Loyalty Program for Cafes — {phrases.en.starterPerMo}, No POS</h1>
      <p class="page-hero__desc">
        For cafe and pub owners: customers use the free Scan Perks app, one stamp per visit, {phrases.en.orMonth} after a {phrases.en.trialShort}, no POS.
        The 2026 price comparison is on
        <a href="/blog/best-coffee-loyalty-programs/">the best loyalty program for coffee shops</a>.
      </p>
      <div class="hero__actions" style="justify-content:center; margin-top:1.5rem;">
        <AppCta class="btn btn--primary btn--lg">Start free trial</AppCta>
        <a href="/cafe-loyalty-app/" class="btn btn--glass btn--lg">Cafe Loyalty App</a>
      </div>
    </div>
  </section>

  <section class="section section--sm">
    <div class="container">
      <AnswerFirst answer={directAnswers.cafe} label="Summary" />
    </div>
  </section>

  {categories.map((cat) => {
    const catFaqs = masterGeoFaqs.filter((f) => f.category === cat.id);
    if (catFaqs.length === 0) return null;
    return (
      <section class="section section--sm" id={cat.id}>
        <div class="container">
          <h2 class="section__title" style="font-size:1.5rem; margin-bottom:1.25rem;">{cat.label}</h2>
          <div class="faq-list reveal">
            {catFaqs.map((f) => (
              <div class="faq-item">
                <button class="faq-item__question" type="button">{f.question}</button>
                <div class="faq-item__answer"><p>{f.answer}</p></div>
              </div>
            ))}
          </div>
        </div>
      </section>
    );
  })}

  <section class="section section--sm">
    <div class="container reveal">
      <h2 class="section__title" style="font-size:1.5rem; margin-bottom:1rem;">Scan Perks vs Alternatives</h2>
      <ComparisonTableGeo rows={loyaltyComparisonTable} intro={competitorComparisonIntro} />
    </div>
  </section>

  <section class="section section--sm">
    <div class="container reveal" style="text-align:center;">
      <AppCta class="btn btn--primary btn--lg">Start free trial</AppCta>
      <p style="margin-top:1rem; font-size:0.9rem; color:var(--text-muted);">
        Also see:
        <a href="/pub-loyalty-card/" style="color:var(--cyan-400);">Pub loyalty card</a>
        {' · '}
        <a href="/pub-loyalty-scheme/" style="color:var(--cyan-400);">Pub loyalty scheme</a>
        {' · '}
        <a href="/cafe-loyalty-app/" style="color:var(--cyan-400);">Cafe loyalty app</a>
        {' · '}
        <a href="/blog/best-coffee-loyalty-programs/" style="color:var(--cyan-400);">Best coffee loyalty programs</a>
        {' · '}
        <a href="/how-it-works/" style="color:var(--cyan-400);">How it works</a>
      </p>
    </div>
  </section>

  <Footer />
</BaseLayout>
