---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import AppCta from '../components/AppCta.astro';
import StoreBadges from '../components/StoreBadges.astro';
import ScanDemo from '../components/ScanDemo.astro';
import PromoVideos from '../components/PromoVideos.astro';
import { landingContent } from '../data/content';
import { promoVideos } from '../data/videos';
import { buildVideoSchema } from '../seo/schema';
import { getHreflangLinks, getPageDef } from '../i18n/pages';
import { phrases } from '../data/site-facts';

const c = landingContent;
const homeDef = getPageDef('home')!;
---

<BaseLayout
  title={c.metaTitle}
  description={c.metaDescription}
  path="/"
  lang="en"
  hreflangLinks={getHreflangLinks(homeDef)}
  faqs={c.faqs}
  extraSchema={promoVideos.map(buildVideoSchema)}
>
  <Nav active="home" pageId="home" />

  <section class="hero hero--action">
    <div class="container">
      <div class="hero__content">
        <div>
          <h1 class="hero__title">QR stamp card for cafes, pubs and bars</h1>
          <p class="hero__lead">
            One counter QR. Customers scan it in the free Scan Perks app and collect stamps toward your reward.
            <span>Set up in 5 minutes. {phrases.en.trial}, {phrases.en.noCard} — then {phrases.en.starterPerMo}.</span>
          </p>
          <div class="hero__actions">
            <AppCta class="btn btn--primary btn--lg" position="hero">Start free trial</AppCta>
            <a href="/how-it-works/" class="btn btn--glass btn--lg">See how it works</a>
          </div>
          <div class="hero__stats">
            <div>
              <div class="hero__stat-value">{phrases.en.starterPerMo}</div>
              <div class="hero__stat-label">After the trial</div>
            </div>
            <div>
              <div class="hero__stat-value">5 min</div>
              <div class="hero__stat-label">Setup</div>
            </div>
            <div>
              <div class="hero__stat-value">{phrases.en.trialDays}</div>
              <div class="hero__stat-label">Free trial</div>
            </div>
          </div>
        </div>
        <div class="hero__visual">
          <ScanDemo />
        </div>
      </div>
    </div>
  </section>

  <section class="section section--sm">
    <div class="container">
      <div class="action-steps">
        <div class="action-step reveal">
          <span class="action-step__num">1</span>
          <h2 class="action-step__title">Print your QR</h2>
          <p class="action-step__desc">Set stamp rewards and put the code on the counter.</p>
          <a href="/how-it-works/" class="btn btn--glass">See how it works</a>
        </div>
        <div class="action-step reveal">
          <span class="action-step__num">2</span>
          <h2 class="action-step__title">Customers scan</h2>
          <p class="action-step__desc">They open the free Scan Perks app (iPhone or Android), tap Scan, and get a stamp. A phone camera opens your venue page.</p>
          <a href="/qr-code-loyalty-program/" class="btn btn--glass">QR code loyalty program</a>
        </div>
        <div class="action-step reveal">
          <span class="action-step__num">3</span>
          <h2 class="action-step__title">Open the dashboard</h2>
          <p class="action-step__desc">Go to app.scan-perks.com. Track stamps and send slow-day offers.</p>
          <AppCta class="btn btn--primary" position="steps">Start free trial</AppCta>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--sm" aria-label="Photos still to add">
    <div class="container">
      <div class="asset-todos">
        <div class="asset-todo">
          <p class="asset-todo__kicker">TODO</p>
          <p class="asset-todo__title">Dashboard screenshot</p>
          <p class="asset-todo__note">Add a real capture of the owner dashboard.</p>
        </div>
        <div class="asset-todo">
          <p class="asset-todo__kicker">TODO</p>
          <p class="asset-todo__title">QR on the counter</p>
          <p class="asset-todo__note">Add a real photo of the QR on a counter.</p>
        </div>
      </div>
    </div>
  </section>

  <PromoVideos />

  <section class="section section--sm">
    <div class="container">
      <div class="venue-cta reveal">
        <a href="/pub-loyalty-card/" class="venue-cta__card venue-cta__card--accent">Pub loyalty card</a>
        <a href="/pub-loyalty-scheme/" class="venue-cta__card">Pub loyalty scheme</a>
        <a href="/cafe-loyalty-app/" class="venue-cta__card">Cafe loyalty app</a>
        <a href="/bar-loyalty-program/" class="venue-cta__card">Bar loyalty</a>
      </div>
    </div>
  </section>

  <section class="section section--sm">
    <div class="container reveal">
      <h2 class="stamps__title">Already collecting stamps?</h2>
      <StoreBadges showHint={false} />
    </div>
  </section>

  <section class="section section--sm" aria-label="Quote still to add">
    <div class="container">
      <div class="asset-todo asset-todo--quote">
        <p class="asset-todo__kicker">TODO</p>
        <p class="asset-todo__title">Customer quote</p>
        <p class="asset-todo__note">Add one quote from a real venue owner.</p>
      </div>
    </div>
  </section>

  <section class="section section--sm">
    <div class="container reveal">
      <div class="cta-banner">
        <h2 class="cta-banner__title">Ready to grow regulars?</h2>
        <p class="cta-banner__desc">Open the app and start your {phrases.en.trialShort}.</p>
        <div class="cta-banner__actions">
          <AppCta class="btn btn--primary btn--lg" position="bottom">Start free trial</AppCta>
        </div>
      </div>
    </div>
  </section>

  <div class="trial-bar">
    <AppCta class="btn btn--primary btn--lg" position="sticky">Start free trial</AppCta>
  </div>

  <Footer />
</BaseLayout>

<style>
  .hero--action {
    padding-top: 7rem;
    padding-bottom: 3rem;
  }

  .hero__title {
    font-size: clamp(1.85rem, 4.2vw, 3.05rem);
    line-height: 1.12;
    max-width: 14em;
  }

  .hero__lead {
    font-size: 1.2rem;
    color: var(--text-secondary);
    line-height: 1.55;
    margin: 0 0 1.75rem;
    max-width: 28rem;
  }

  .hero__lead span {
    display: block;
    margin-top: 0.35rem;
    color: var(--blue-300);
    font-weight: 600;
    font-size: 1.05rem;
  }

  .action-steps {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
  }

  .action-step {
    padding: 1.5rem;
    border-radius: var(--radius-md, 16px);
    border: 1px solid var(--glass-border);
    background: rgba(255, 255, 255, 0.03);
    text-align: center;
  }

  .action-step__num {
    display: inline-flex;
    width: 2rem;
    height: 2rem;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    background: rgba(34, 211, 238, 0.15);
    color: var(--cyan-400);
    font-weight: 800;
    font-size: 0.9rem;
    margin-bottom: 0.85rem;
  }

  .action-step__title {
    font-size: 1.15rem;
    margin: 0 0 0.5rem;
    color: #fff;
  }

  .action-step__desc {
    font-size: 0.9rem;
    color: var(--text-secondary);
    line-height: 1.5;
    margin: 0 0 1.15rem;
  }

  .asset-todos {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
  }

  .asset-todo {
    min-height: 16rem;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: flex-end;
    gap: 0.4rem;
    padding: 1.25rem;
    border: 2px dashed rgba(148, 163, 184, 0.55);
    border-radius: var(--radius-md, 16px);
    background: rgba(255, 255, 255, 0.02);
  }

  .asset-todo--quote {
    min-height: 10rem;
    max-width: 40rem;
    margin: 0 auto;
  }

  .asset-todo__kicker {
    margin: 0;
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    color: var(--cyan-400);
  }

  .asset-todo__title {
    margin: 0;
    color: #fff;
    font-size: 1.15rem;
    font-weight: 700;
  }

  .asset-todo__note {
    margin: 0;
    color: var(--text-secondary);
    font-size: 0.95rem;
    line-height: 1.5;
  }

  .venue-cta {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.75rem;
  }

  .venue-cta__card {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1rem 0.75rem;
    border-radius: var(--radius-sm, 10px);
    border: 1px solid var(--glass-border);
    background: rgba(255, 255, 255, 0.03);
    color: var(--text-secondary);
    font-weight: 600;
    font-size: 0.9rem;
    text-align: center;
    transition: border-color 0.2s, color 0.2s, transform 0.2s;
  }

  .venue-cta__card:hover {
    border-color: rgba(34, 211, 238, 0.45);
    color: #fff;
    transform: translateY(-2px);
  }

  .venue-cta__card--accent {
    border-color: rgba(34, 211, 238, 0.4);
    color: var(--cyan-400);
  }

  .stamps__title {
    text-align: center;
    font-size: clamp(1.6rem, 3vw, 2.1rem);
    margin-bottom: 1.5rem;
  }

  .trial-bar {
    display: none;
  }

  @media (max-width: 900px) {
    .action-steps,
    .asset-todos {
      grid-template-columns: 1fr;
    }

    .venue-cta {
      grid-template-columns: 1fr 1fr;
    }

    .hero__title,
    .hero__lead {
      margin-left: auto;
      margin-right: auto;
    }
  }

  @media (max-width: 768px) {
    .trial-bar {
      display: flex;
      position: fixed;
      left: 0;
      right: 0;
      bottom: 0;
      z-index: 1001;
      justify-content: center;
      padding: 0.75rem 1rem calc(0.75rem + env(safe-area-inset-bottom));
      background: rgba(2, 6, 23, 0.94);
      border-top: 1px solid var(--glass-border);
    }

    .trial-bar :global(.btn) {
      width: 100%;
      max-width: 28rem;
    }

    :global(.footer) {
      padding-bottom: calc(5.5rem + env(safe-area-inset-bottom));
    }
  }
</style>
