---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import AppCta from '../components/AppCta.astro';
import StoreBadges from '../components/StoreBadges.astro';
import PromoVideos from '../components/PromoVideos.astro';
import Hero from '../components/Hero.astro';
import StepList from '../components/StepList.astro';
import Step from '../components/Step.astro';
import CTASection from '../components/CTASection.astro';
import FAQSection from '../components/FAQSection.astro';
import InternalLinks from '../components/InternalLinks.astro';
import { landingContent } from '../data/content';
import { promoVideos } from '../data/videos';
import { buildVideoSchema } from '../seo/schema';
import { getHreflangLinks, getPageDef } from '../i18n/pages';
import { phrases, siteFacts } from '../data/site-facts';

const c = landingContent;
const homeDef = getPageDef('home')!;

/** Owner FAQ on home — subset of /faq/ facts; cap for FAQPage JSON-LD. */
const homeFaqs = [
  {
    question: 'How much does Scan Perks cost for cafe and pub owners?',
    answer: `Starter is ${phrases.en.starterPerMonth} for ${phrases.en.scans}. Growth is ${phrases.en.growthPerMonth} for ${phrases.en.unlimitedScans} — that means unlimited scans, not unlimited push. Every venue starts with a ${phrases.en.trial} with ${phrases.en.noCard}.`,
  },
  {
    question: 'Do customers need to download an app?',
    answer:
      'Yes. Customers collect stamps only in the free Scan Perks app on iPhone or Android. A phone camera pointed at your QR opens your venue page with the reward and an app link — it does not add the stamp. Owners run the venue at app.scan-perks.com in the browser.',
  },
  {
    question: 'Do I need to change my POS?',
    answer:
      'No. Scan Perks uses a printed counter QR only — no Square, Toast, or POS API required. Create the venue, print the QR, and put it by the till.',
  },
  {
    question: 'What does one venue per login mean?',
    answer: `${phrases.en.oneVenuePerLoginCap}. The Business tab at app.scan-perks.com is the owner dashboard for that venue: stamp rules, QR poster, members, and offers.`,
  },
  {
    question: `What happens after the ${phrases.en.trial}?`,
    answer: `Add a card to continue on Starter at ${phrases.en.starterPerMonth}. Without billing, the QR stops adding new stamps after day ${siteFacts.trial.days}; stamps customers already earned are kept.`,
  },
  {
    question: 'How does the counter QR work?',
    answer:
      'You set a stamp rule (for example 8 stamps for a free coffee), tap Create my QR, and print it. Customers open the Scan Perks app, tap Scan, and point the camera at your poster. One stamp lands per visit (one scan per venue per day).',
  },
  {
    question: 'Is Scan Perks for cafes only, or pubs and bars too?',
    answer:
      'Cafes, pubs, and bars use the same QR stamp product. Happy-hour double stamps suit quiet nights at the bar. See the cafe loyalty app, pub loyalty card, and bar loyalty program pages for owner detail.',
  },
  {
    question: 'What is the best loyalty program for independent cafes?',
    answer: `For independents who want no POS change: Scan Perks — counter QR stamp card, analytics, and push offers. Starter ${phrases.en.starterPerMonth} after a ${phrases.en.trial} at app.scan-perks.com. Full owner answers live on /faq/.`,
  },
];
---

<BaseLayout
  title={c.metaTitle}
  description={c.metaDescription}
  path="/"
  lang="en"
  hreflangLinks={getHreflangLinks(homeDef)}
  faqs={homeFaqs}
  extraSchema={promoVideos.map(buildVideoSchema)}
>
  <Nav active="home" pageId="home" />

  <Hero variant="home">
    <div class="hero__copy hero__copy--solo">
      <p class="hero__brand-signal">Scan Perks</p>
      <h1 class="hero__title">QR stamp card for cafes, pubs and bars</h1>
      <p class="hero__lead">
        One counter QR. Customers open the Scan Perks app, tap Scan, and stamp at your poster.
        <span>Starter {phrases.en.starterPerMo} ({phrases.en.scans}) after a {phrases.en.trialShort} with {phrases.en.noCard}.</span>
      </p>
      <div class="hero__actions">
        <AppCta class="btn btn--primary btn--lg" position="hero">Start free trial</AppCta>
        <a href="#see-how-it-works" class="btn btn--glass btn--lg">See how it works</a>
      </div>
      <p class="hero__note">
        Phone camera may open the venue page with an app link — that does not add a stamp.
      </p>
    </div>
  </Hero>

  <section class="section section--sm">
    <div class="container">
      <StepList>
        <Step n={1} title="Print your QR" description="Set stamp rewards and put the code on the counter.">
          <a href="/how-it-works/" class="btn btn--glass">Setup steps</a>
        </Step>
        <Step n={2} title="Customers scan in the app" description="They open the free Scan Perks app, tap Scan, and get a stamp. A phone camera opens your venue page with an app link.">
          <a href="/qr-code-loyalty-program/" class="btn btn--glass">QR loyalty</a>
        </Step>
        <Step n={3} title="Run the dashboard" description="Owners use app.scan-perks.com — members, visits, and slow-day offers. No POS tablet.">
          <AppCta class="btn btn--primary" position="steps">Start free trial</AppCta>
        </Step>
      </StepList>
    </div>
  </section>

  <section class="section section--sm" aria-labelledby="owner-facts-title">
    <div class="container">
      <div class="section__header">
        <h2 id="owner-facts-title" class="section__title" style="font-size:1.75rem;">What owners get</h2>
        <p class="owner-facts__intro">True product limits from Scan Perks — not invented stats.</p>
      </div>
      <div class="owner-facts">
        <div class="owner-facts__item">
          <h3>Trial → Starter → Growth</h3>
          <p>
            A {phrases.en.trial} with {phrases.en.noCard} starts when you create your QR. Then Starter is {phrases.en.starterPerMonth} for {phrases.en.scans}; Growth is {phrases.en.growthPerMonth} for {phrases.en.unlimitedScans} (not unlimited push).
          </p>
          <a href="/pricing/">Starter vs Growth →</a>
        </div>
        <div class="owner-facts__item">
          <h3>{phrases.en.oneVenuePerLoginCap}</h3>
          <p>
            {phrases.en.stampsInInstalledAppCap}. Owners manage that venue from the web dashboard at app.scan-perks.com.
          </p>
          <a href="/how-it-works/">How setup works →</a>
        </div>
        <div class="owner-facts__item">
          <h3>No POS change</h3>
          <p>
            Print one counter QR. Customers stamp in the free Scan Perks app. You do not need Square, Toast, or new hardware.
          </p>
          <a href="/cafe-loyalty-app/">Cafe loyalty app →</a>
        </div>
      </div>
    </div>
  </section>

  <PromoVideos
    id="see-how-it-works"
    title="See how it works"
    intro="Owner demos: customers open the Scan Perks app, tap Scan, and stamp at your counter QR. A phone camera may open the venue page with an app link — that is not a stamp."
  />

  <section class="section section--sm">
    <div class="container">
      <div class="venue-cta reveal">
        <a href="/cafe-loyalty-app/" class="venue-cta__card venue-cta__card--accent">Cafe loyalty app</a>
        <a href="/pub-loyalty-card/" class="venue-cta__card">Pub loyalty card</a>
        <a href="/pub-loyalty-scheme/" class="venue-cta__card">Pub loyalty scheme</a>
        <a href="/bar-loyalty-program/" class="venue-cta__card">Bar loyalty</a>
      </div>
    </div>
  </section>

  <FAQSection faqs={homeFaqs} title="Owner FAQ" />
  <p class="home-faq-more">
    <a href="/faq/">Full owner FAQ →</a>
    {' · '}
    <a href="/pricing/">Pricing</a>
    {' · '}
    <a href="/brewstamp-alternative/">Brewstamp alternative</a>
  </p>

  <section class="section section--sm">
    <div class="container reveal">
      <h2 class="stamps__title">Already collecting stamps?</h2>
      <p class="stamps__hint">{phrases.en.stampLine}</p>
      <StoreBadges showHint={false} />
      <p class="stamps__owner-note">
        Owners: start at app.scan-perks.com · Customers: free Scan Perks app
      </p>
    </div>
  </section>

  <InternalLinks />

  <CTASection title="Ready to grow regulars?" description={`Open app.scan-perks.com and start your ${phrases.en.trialShort} with ${phrases.en.noCard}.`}>
    <AppCta class="btn btn--primary btn--lg" position="bottom">Start free trial</AppCta>
    <AppCta class="btn btn--glass btn--lg" position="bottom-customer">Get the Rewards App</AppCta>
  </CTASection>

  <div class="trial-bar">
    <AppCta class="btn btn--primary btn--lg" position="sticky">Start free trial</AppCta>
  </div>

  <Footer />
</BaseLayout>

<style>
  .hero__brand-signal {
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--cyan-400);
    margin: 0 0 0.75rem;
  }

  .hero__copy--solo {
    max-width: 40rem;
    margin: 0 auto;
    text-align: center;
  }

  .hero__copy--solo :global(.hero__title),
  .hero__copy--solo :global(.hero__lead) {
    margin-left: auto;
    margin-right: auto;
  }

  .hero__copy--solo :global(.hero__actions) {
    justify-content: center;
  }

  .hero__note {
    margin: -1.25rem 0 0;
    color: var(--text-muted);
    font-size: 0.9rem;
    line-height: 1.5;
  }

  :global(.hero--home .hero__content) {
    grid-template-columns: 1fr;
    justify-items: center;
  }

  .owner-facts__intro {
    color: var(--text-secondary);
    max-width: 36rem;
    margin: 0.5rem auto 0;
    text-align: center;
    line-height: 1.55;
  }

  .owner-facts {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
    margin-top: 1.75rem;
  }

  .owner-facts__item {
    padding: 1.35rem 1.25rem;
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-md, 16px);
    background: rgba(255, 255, 255, 0.03);
  }

  .owner-facts__item h3 {
    margin: 0 0 0.65rem;
    font-size: 1.05rem;
    color: var(--blue-300);
  }

  .owner-facts__item p {
    margin: 0 0 0.85rem;
    color: var(--text-secondary);
    font-size: 0.95rem;
    line-height: 1.6;
  }

  .owner-facts__item a {
    color: var(--cyan-400);
    font-weight: 600;
    font-size: 0.9rem;
  }

  .home-faq-more {
    text-align: center;
    margin: -0.5rem 0 0;
    padding: 0 1rem 1.5rem;
    color: var(--text-muted);
    font-size: 0.95rem;
  }

  .home-faq-more a {
    color: var(--cyan-400);
    font-weight: 600;
  }

  .venue-cta {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.75rem;
  }

  .venue-cta__card {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: var(--target-min);
    padding: var(--space-4) var(--space-3);
    border-radius: var(--radius-sm);
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    color: var(--color-text-secondary);
    font-weight: var(--weight-semibold);
    font-size: var(--text-sm);
    text-align: center;
    transition: border-color 0.2s, color 0.2s, transform 0.2s;
  }

  .venue-cta__card:hover {
    border-color: rgba(34, 211, 238, 0.45);
    color: #fff;
    transform: translateY(-2px);
  }

  .venue-cta__card--accent {
    border-color: rgba(34, 211, 238, 0.4);
    color: var(--cyan-400);
  }

  .stamps__title {
    text-align: center;
    font-size: clamp(1.6rem, 3vw, 2.1rem);
    margin-bottom: 0.75rem;
  }

  .stamps__hint {
    max-width: 40rem;
    margin: 0 auto 1.25rem;
    color: var(--text-secondary);
    font-size: 1.05rem;
    line-height: 1.5;
    text-align: center;
  }

  .stamps__owner-note {
    margin-top: 1rem;
    text-align: center;
    color: var(--text-muted);
    font-size: 0.9rem;
  }

  .trial-bar {
    display: none;
  }

  @media (max-width: 900px) {
    .owner-facts {
      grid-template-columns: 1fr;
    }

    .venue-cta {
      grid-template-columns: 1fr 1fr;
    }

    .hero__title,
    .hero__lead {
      margin-left: auto;
      margin-right: auto;
    }
  }

  @media (max-width: 768px) {
    .trial-bar {
      display: flex;
      position: fixed;
      left: 0;
      right: 0;
      bottom: 0;
      z-index: 1001;
      justify-content: center;
      padding: 0.75rem 1rem calc(0.75rem + env(safe-area-inset-bottom));
      background: rgba(2, 6, 23, 0.94);
      border-top: 1px solid var(--glass-border);
    }

    .trial-bar :global(.btn) {
      width: 100%;
      max-width: 28rem;
    }

    :global(.footer) {
      padding-bottom: calc(5.5rem + env(safe-area-inset-bottom));
    }
  }
</style>
