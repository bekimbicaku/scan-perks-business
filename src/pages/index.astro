---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import AppCta from '../components/AppCta.astro';
import StoreBadges from '../components/StoreBadges.astro';
import ScanDemo from '../components/ScanDemo.astro';
import PromoVideos from '../components/PromoVideos.astro';
import Hero from '../components/Hero.astro';
import StepList from '../components/StepList.astro';
import Step from '../components/Step.astro';
import CTASection from '../components/CTASection.astro';
import { landingContent } from '../data/content';
import { promoVideos } from '../data/videos';
import { buildVideoSchema } from '../seo/schema';
import { getHreflangLinks, getPageDef } from '../i18n/pages';
import { phrases } from '../data/site-facts';

const c = landingContent;
const homeDef = getPageDef('home')!;
---

<BaseLayout
  title={c.metaTitle}
  description={c.metaDescription}
  path="/"
  lang="en"
  hreflangLinks={getHreflangLinks(homeDef)}
  faqs={c.faqs}
  extraSchema={promoVideos.map(buildVideoSchema)}
>
  <Nav active="home" pageId="home" />

  <Hero variant="home">
    <div>
      <h1 class="hero__title">QR stamp card for cafes, pubs and bars</h1>
      <p class="hero__lead">
        One counter QR. Customers scan it in the free Scan Perks app and collect stamps toward your reward.
        <span>Set up in 5 minutes. {phrases.en.trial}, {phrases.en.noCard} — then {phrases.en.starterPerMo}.</span>
      </p>
      <div class="hero__actions">
        <AppCta class="btn btn--primary btn--lg" position="hero">Start free trial</AppCta>
        <a href="/how-it-works/" class="btn btn--glass btn--lg">See how it works</a>
      </div>
      <div class="hero__stats">
        <div>
          <div class="hero__stat-value">{phrases.en.starterPerMo}</div>
          <div class="hero__stat-label">After the trial</div>
        </div>
        <div>
          <div class="hero__stat-value">5 min</div>
          <div class="hero__stat-label">Setup</div>
        </div>
        <div>
          <div class="hero__stat-value">{phrases.en.trialDays}</div>
          <div class="hero__stat-label">Free trial</div>
        </div>
      </div>
    </div>
    <div class="hero__visual">
      <ScanDemo />
    </div>
  </Hero>

  <section class="section section--sm">
    <div class="container">
      <StepList>
        <Step n={1} title="Print your QR" description="Set stamp rewards and put the code on the counter.">
          <a href="/how-it-works/" class="btn btn--glass">See how it works</a>
        </Step>
        <Step n={2} title="Customers scan" description="They open the free Scan Perks app (iPhone or Android), tap Scan, and get a stamp. A phone camera opens your venue page.">
          <a href="/qr-code-loyalty-program/" class="btn btn--glass">QR code loyalty program</a>
        </Step>
        <Step n={3} title="Open the dashboard" description="Go to app.scan-perks.com. Track stamps and send slow-day offers.">
          <AppCta class="btn btn--primary" position="steps">Start free trial</AppCta>
        </Step>
      </StepList>
    </div>
  </section>

  <section class="section section--sm" aria-label="Owner dashboard and counter QR">
    <div class="container">
      <div class="product-shots">
        <figure class="product-shot">
          <img
            src="/images/owner-dashboard.png"
            alt="Owner dashboard in the Scan Perks app, with the venue plan, scan totals, and QR code"
            width="780"
            height="4060"
          />
          <figcaption>Owner dashboard</figcaption>
        </figure>
        <figure class="product-shot">
          <img
            src="/images/counter-qr.png"
            alt="Counter QR in the Scan Perks app, on the poster a venue prints for the counter"
            width="780"
            height="1688"
          />
          <figcaption>QR for the counter</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <PromoVideos />

  <section class="section section--sm">
    <div class="container">
      <div class="venue-cta reveal">
        <a href="/pub-loyalty-card/" class="venue-cta__card venue-cta__card--accent">Pub loyalty card</a>
        <a href="/pub-loyalty-scheme/" class="venue-cta__card">Pub loyalty scheme</a>
        <a href="/cafe-loyalty-app/" class="venue-cta__card">Cafe loyalty app</a>
        <a href="/bar-loyalty-program/" class="venue-cta__card">Bar loyalty</a>
      </div>
    </div>
  </section>

  <section class="section section--sm">
    <div class="container reveal">
      <h2 class="stamps__title">Already collecting stamps?</h2>
      <StoreBadges showHint={false} />
    </div>
  </section>

  <section class="section section--sm" aria-label="How a stamp is collected">
    <div class="container">
      <p class="fact-line">{phrases.en.stampLine}</p>
    </div>
  </section>

  <CTASection title="Ready to grow regulars?" description={`Open the app and start your ${phrases.en.trialShort}.`}>
    <AppCta class="btn btn--primary btn--lg" position="bottom">Start free trial</AppCta>
  </CTASection>

  <div class="trial-bar">
    <AppCta class="btn btn--primary btn--lg" position="sticky">Start free trial</AppCta>
  </div>

  <Footer />
</BaseLayout>

<style>
  .product-shots {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
    align-items: start;
  }

  .product-shot {
    margin: 0;
    padding: 1.25rem 1.25rem 1rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md, 16px);
    background: rgba(255, 255, 255, 0.03);
  }

  .product-shot img {
    display: block;
    width: min(100%, 280px);
    height: auto;
    margin: 0 auto;
    border-radius: 12px;
  }

  .product-shot figcaption {
    margin: 0.9rem 0 0;
    color: var(--text-secondary);
    font-size: 0.95rem;
    text-align: center;
  }

  .fact-line {
    max-width: 40rem;
    margin: 0 auto;
    color: var(--text-secondary);
    font-size: 1.15rem;
    line-height: 1.5;
    text-align: center;
  }

  .venue-cta {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.75rem;
  }

  .venue-cta__card {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: var(--target-min);
    padding: var(--space-4) var(--space-3);
    border-radius: var(--radius-sm);
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    color: var(--color-text-secondary);
    font-weight: var(--weight-semibold);
    font-size: var(--text-sm);
    text-align: center;
    transition: border-color 0.2s, color 0.2s, transform 0.2s;
  }

  .venue-cta__card:hover {
    border-color: rgba(34, 211, 238, 0.45);
    color: #fff;
    transform: translateY(-2px);
  }

  .venue-cta__card--accent {
    border-color: rgba(34, 211, 238, 0.4);
    color: var(--cyan-400);
  }

  .stamps__title {
    text-align: center;
    font-size: clamp(1.6rem, 3vw, 2.1rem);
    margin-bottom: 1.5rem;
  }

  .trial-bar {
    display: none;
  }

  @media (max-width: 900px) {
    .product-shots {
      grid-template-columns: 1fr;
    }

    .venue-cta {
      grid-template-columns: 1fr 1fr;
    }

    .hero__title,
    .hero__lead {
      margin-left: auto;
      margin-right: auto;
    }
  }

  @media (max-width: 768px) {
    .trial-bar {
      display: flex;
      position: fixed;
      left: 0;
      right: 0;
      bottom: 0;
      z-index: 1001;
      justify-content: center;
      padding: 0.75rem 1rem calc(0.75rem + env(safe-area-inset-bottom));
      background: rgba(2, 6, 23, 0.94);
      border-top: 1px solid var(--glass-border);
    }

    .trial-bar :global(.btn) {
      width: 100%;
      max-width: 28rem;
    }

    :global(.footer) {
      padding-bottom: calc(5.5rem + env(safe-area-inset-bottom));
    }
  }
</style>
