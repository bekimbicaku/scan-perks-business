---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import AppCta from '../components/AppCta.astro';
import StoreBadges from '../components/StoreBadges.astro';
import ScanDemo from '../components/ScanDemo.astro';
import { landingContent, SITE } from '../data/content';
import { G2_LISTING } from '../data/g2AndOutreach';
import { buildSoftwareApplicationSchema } from '../seo/schema';
import { getHreflangLinks, getPageDef } from '../i18n/pages';

const c = landingContent;
const homeDef = getPageDef('home')!;
const g2Url = G2_LISTING.profileUrl || SITE.social.g2;
---

<BaseLayout
  title={c.metaTitle}
  description={c.metaDescription}
  path="/"
  lang="en"
  hreflangLinks={getHreflangLinks(homeDef)}
  keywords={c.metaKeywords}
  faqs={c.faqs}
  extraSchema={[buildSoftwareApplicationSchema()]}
>
  <Nav active="home" pageId="home" />

  <section class="hero hero--action">
    <div class="container">
      <div class="hero__content">
        <div>
          <div class="hero__badge">
            <span class="hero__badge-dot"></span>
            QR loyalty for cafes, pubs &amp; bars
          </div>
          <h1 class="hero__title">Scan Perks</h1>
          <p class="hero__lead">
            Customers scan. Earn stamps. Come back.
            <span>Launch in 5 minutes — from $10/mo.</span>
          </p>
          <div class="hero__actions">
            <AppCta class="btn btn--primary btn--lg">Open App — Free Trial</AppCta>
            <a href={g2Url} class="btn btn--glass btn--lg" rel="noopener noreferrer" target="_blank">
              Leave a G2 Review
            </a>
          </div>
          <div class="hero__store-row">
            <StoreBadges showHint={false} centered={false} />
          </div>
          <div class="hero__stats">
            <div>
              <div class="hero__stat-value">500+</div>
              <div class="hero__stat-label">Venues</div>
            </div>
            <div>
              <div class="hero__stat-value">50K+</div>
              <div class="hero__stat-label">Members</div>
            </div>
            <div>
              <div class="hero__stat-value">14 days</div>
              <div class="hero__stat-label">Free trial</div>
            </div>
          </div>
        </div>
        <div class="hero__visual">
          <ScanDemo />
        </div>
      </div>
    </div>
  </section>

  <section class="section section--sm">
    <div class="container">
      <div class="action-steps">
        <div class="action-step reveal">
          <span class="action-step__num">1</span>
          <h2 class="action-step__title">Open the app</h2>
          <p class="action-step__desc">Go to app.scan-perks.com or download on iOS / Android.</p>
          <AppCta class="btn btn--primary">Start free trial</AppCta>
        </div>
        <div class="action-step reveal">
          <span class="action-step__num">2</span>
          <h2 class="action-step__title">Print your QR</h2>
          <p class="action-step__desc">Set stamp rewards and put the code on the counter.</p>
          <a href="/how-it-works/" class="btn btn--glass">See how it works</a>
        </div>
        <div class="action-step reveal">
          <span class="action-step__num">3</span>
          <h2 class="action-step__title">Share the love</h2>
          <p class="action-step__desc">Using Scan Perks? A short G2 review helps other owners find us.</p>
          <a href={g2Url} class="btn btn--glass" rel="noopener noreferrer" target="_blank">Leave G2 review →</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--sm">
    <div class="container">
      <div class="venue-cta reveal">
        <a href="/pub-loyalty-card/" class="venue-cta__card venue-cta__card--accent">Pub loyalty card</a>
        <a href="/pub-loyalty-scheme/" class="venue-cta__card">Pub loyalty scheme</a>
        <a href="/cafe-loyalty-app/" class="venue-cta__card">Cafe loyalty</a>
        <a href="/bar-loyalty-program/" class="venue-cta__card">Bar loyalty</a>
      </div>
    </div>
  </section>

  <section class="section section--sm">
    <div class="container reveal">
      <div class="cta-banner">
        <h2 class="cta-banner__title">Ready to grow regulars?</h2>
        <p class="cta-banner__desc">Open the app, start your 14-day trial, or leave a review if you already use Scan Perks.</p>
        <div class="cta-banner__actions cta-banner__actions--stack">
          <div class="cta-banner__btns">
            <AppCta class="btn btn--primary btn--lg">Open app.scan-perks.com</AppCta>
            <a href={g2Url} class="btn btn--glass btn--lg" rel="noopener noreferrer" target="_blank">G2 Review</a>
          </div>
          <StoreBadges showHint={false} />
        </div>
      </div>
    </div>
  </section>

  <Footer />
</BaseLayout>

<style>
  .hero--action {
    padding-top: 7rem;
    padding-bottom: 3rem;
  }

  .hero__lead {
    font-size: 1.2rem;
    color: var(--text-secondary);
    line-height: 1.55;
    margin: 0 0 1.75rem;
    max-width: 28rem;
  }

  .hero__lead span {
    display: block;
    margin-top: 0.35rem;
    color: var(--blue-300);
    font-weight: 600;
    font-size: 1.05rem;
  }

  .hero__store-row {
    margin-top: 1.25rem;
  }

  .hero__store-row :global(.store-badges) {
    justify-content: flex-start;
  }

  .action-steps {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
  }

  .action-step {
    padding: 1.5rem;
    border-radius: var(--radius-md, 16px);
    border: 1px solid var(--glass-border);
    background: rgba(255, 255, 255, 0.03);
    text-align: center;
  }

  .action-step__num {
    display: inline-flex;
    width: 2rem;
    height: 2rem;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    background: rgba(34, 211, 238, 0.15);
    color: var(--cyan-400);
    font-weight: 800;
    font-size: 0.9rem;
    margin-bottom: 0.85rem;
  }

  .action-step__title {
    font-size: 1.15rem;
    margin: 0 0 0.5rem;
    color: #fff;
  }

  .action-step__desc {
    font-size: 0.9rem;
    color: var(--text-secondary);
    line-height: 1.5;
    margin: 0 0 1.15rem;
  }

  .venue-cta {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.75rem;
  }

  .venue-cta__card {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1rem 0.75rem;
    border-radius: var(--radius-sm, 10px);
    border: 1px solid var(--glass-border);
    background: rgba(255, 255, 255, 0.03);
    color: var(--text-secondary);
    font-weight: 600;
    font-size: 0.9rem;
    text-align: center;
    transition: border-color 0.2s, color 0.2s, transform 0.2s;
  }

  .venue-cta__card:hover {
    border-color: rgba(34, 211, 238, 0.45);
    color: #fff;
    transform: translateY(-2px);
  }

  .venue-cta__card--accent {
    border-color: rgba(34, 211, 238, 0.4);
    color: var(--cyan-400);
  }

  .cta-banner__actions--stack {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
  }

  .cta-banner__btns {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    justify-content: center;
  }

  @media (max-width: 900px) {
    .action-steps {
      grid-template-columns: 1fr;
    }

    .venue-cta {
      grid-template-columns: 1fr 1fr;
    }

    .hero__store-row :global(.store-badges) {
      justify-content: center;
    }

    .hero__lead {
      margin-left: auto;
      margin-right: auto;
    }
  }
</style>
