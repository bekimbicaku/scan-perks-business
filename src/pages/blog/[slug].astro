---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import FAQSection from '../../components/FAQSection.astro';
import AppCta from '../../components/AppCta.astro';
import { blogArticles, getBlogArticle } from '../../data/blogArticles';
import { cafeConversationalFaqs } from '../../data/conversationalFaqs';
import { buildBlogPostingSchema } from '../../seo/schema';

export function getStaticPaths() {
  return blogArticles.map((a) => ({ params: { slug: a.slug } }));
}

const { slug } = Astro.params;
const article = getBlogArticle(slug!);
if (!article) return Astro.redirect('/404');

const path = `/blog/${article.slug}/`;

const blogExtraFaqs =
  article.slug === 'best-coffee-loyalty-programs' ? cafeConversationalFaqs : [];
const allFaqs = [...article.faqs, ...blogExtraFaqs];

const schema = buildBlogPostingSchema({
  title: article.title,
  description: article.description,
  path,
  publishedAt: article.publishedAt,
});
if (article.updatedAt) {
  (schema as Record<string, unknown>).dateModified = article.updatedAt;
}
---

<BaseLayout
  title={article.metaTitle}
  description={article.description}
  path={path}
  keywords={article.keywords}
  faqs={allFaqs}
  breadcrumbs={[
    { name: 'Home', path: '/' },
    { name: 'Blog', path: '/blog/' },
    { name: article.title, path },
  ]}
  extraSchema={[schema]}
>
  <Nav active="blog" />

  <article>
    <section class="page-hero">
      <div class="container reveal">
        <p class="blog-card__date">
          {article.publishedAt}
          {article.updatedAt && ` · Updated ${article.updatedAt}`}
        </p>
        <h1 class="page-hero__title">{article.title}</h1>
        <p class="page-hero__desc">{article.description}</p>
        <div class="hero__actions" style="justify-content:center; margin-top:1.25rem;">
          <AppCta class="btn btn--primary btn--lg">Open App — Free Trial</AppCta>
          <a href={article.clusterPage.href} class="btn btn--glass btn--lg">{article.clusterPage.label}</a>
        </div>
      </div>
    </section>

    <section class="section section--sm">
      <div class="container">
        <div class="quick-answer reveal">
          <p class="quick-answer__label">Quick Answer</p>
          <p>{article.answer}</p>
        </div>

        {article.sections.map((s) => (
          <div class="glass-card reveal" style="margin-bottom:1.5rem;">
            <h2 class="feature-card__title" style="font-size:1.25rem;">{s.heading}</h2>
            <p class="feature-card__desc" style="margin-top:0.5rem; font-size:1rem;">{s.body}</p>
          </div>
        ))}

        {article.comparison && article.comparison.length > 0 && (
          <div class="glass-card reveal" style="margin-bottom:1.5rem; overflow-x:auto;">
            <h2 class="feature-card__title" style="font-size:1.25rem; margin-bottom:1rem;">
              Coffee loyalty comparison
            </h2>
            <table class="comparison-table">
              <thead>
                <tr>
                  <th>Feature</th>
                  <th>Scan Perks</th>
                  <th>Paper cards</th>
                  <th>Enterprise</th>
                </tr>
              </thead>
              <tbody>
                {article.comparison.map((row) => (
                  <tr>
                    <td>{row.feature}</td>
                    <td class="comparison-table__highlight">{row.scanPerks}</td>
                    <td>{row.traditional}</td>
                    <td>{row.enterprise}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )}

        {article.relatedLinks && article.relatedLinks.length > 0 && (
          <nav class="glass-card reveal" style="margin-bottom:1.5rem;" aria-label="Related guides">
            <h2 class="feature-card__title" style="font-size:1.15rem; margin-bottom:0.75rem;">
              Related guides
            </h2>
            <ul style="margin:0; padding-left:1.1rem; color:var(--text-secondary); line-height:1.8;">
              {article.relatedLinks.map((l) => (
                <li>
                  <a href={l.href} style="color:var(--cyan-400); font-weight:600;">{l.label}</a>
                </li>
              ))}
            </ul>
          </nav>
        )}

        <div class="glass-card reveal" style="margin-top:2rem;">
          <p class="feature-card__desc">
            Ready to launch your <a href={article.clusterPage.href} style="color:var(--cyan-400);">{article.clusterPage.anchor}</a>?
          </p>
          <AppCta class="btn btn--primary" style="margin-top:1rem;">Start Free Trial</AppCta>
        </div>
      </div>
    </section>

    <FAQSection faqs={allFaqs} />
  </article>

  <Footer />
</BaseLayout>
