---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import AnswerFirst from '../../components/AnswerFirst.astro';
import FeatureBulletList from '../../components/FeatureBulletList.astro';
import CaseStudies from '../../components/CaseStudies.astro';
import AppCta from '../../components/AppCta.astro';
import {
  directAnswers,
  platformStats,
  technicalDetails,
  caseStudies,
  scanPerksFeatureList,
} from '../../data/geoContent';
import { buildSoftwareApplicationSchema, buildReviewSchema } from '../../seo/schema';
import { SITE } from '../../data/content';
import { getHreflangLinks, getPageDef } from '../../i18n/pages';

const reviewSchemas = caseStudies.map((s) =>
  buildReviewSchema({ author: s.author, reviewBody: s.reviewBody, datePublished: s.datePublished })
);
---

<BaseLayout
  title="About Scan Perks — QR Loyalty for Cafes & Bars"
  description="Scan Perks: 500+ venues, 50K+ loyalty members. QR cafe & bar loyalty from $10/mo. Founded 2024. iOS/Android apps, no POS required."
  path="/about/"
  lang="en"
  hreflangLinks={getHreflangLinks(getPageDef('about')!)}
  breadcrumbs={[{ name: 'Home', path: '/' }, { name: 'About', path: '/about/' }]}
  extraSchema={[buildSoftwareApplicationSchema(), ...reviewSchemas]}
>
  <Nav active="about" pageId="about" />

  <section class="page-hero">
    <div class="container reveal">
      <span class="section__label">About</span>
      <h1 class="page-hero__title">QR Loyalty Platform for Independent Hospitality</h1>
      <p class="page-hero__desc">Founded {platformStats.founded}. Built for cafes, bars, and restaurants that need affordable loyalty — not enterprise contracts.</p>
    </div>
  </section>

  <section class="section section--sm">
    <div class="container">
      <AnswerFirst answer={directAnswers.home} />

      <div class="stats-row reveal">
        <div class="stats-row__item"><strong>{platformStats.venues}</strong><span>venue accounts</span></div>
        <div class="stats-row__item"><strong>{platformStats.activeMembers}</strong><span>loyalty members</span></div>
        <div class="stats-row__item"><strong>{platformStats.repeatVisitLift}</strong><span>repeat visit lift (reported)</span></div>
        <div class="stats-row__item"><strong>${platformStats.starterPrice}/mo</strong><span>starting price</span></div>
      </div>
    </div>
  </section>

  <section class="section section--sm">
    <div class="container">
      <h2 class="section__title" style="font-size:1.5rem; margin-bottom:1rem;">What We Build</h2>
      <p style="color:var(--text-secondary); line-height:1.8; margin-bottom:1.5rem;">
        Scan Perks is a QR-based business loyalty program for single-location hospitality venues. Customers use iOS or Android apps to scan a venue QR and earn stamp-style rewards. Owners manage programs at {SITE.appWebUrl} — no POS integration, no dedicated hardware.
      </p>
      <FeatureBulletList items={scanPerksFeatureList} />
    </div>
  </section>

  <section class="section section--sm">
    <div class="container">
      <h2 class="section__title" style="font-size:1.5rem; margin-bottom:1rem;">Technical Overview</h2>
      <div class="tech-grid">
        <div class="glass-card tech-card">
          <h3>QR &amp; Security</h3>
          <p>{technicalDetails.qrSecurity}</p>
        </div>
        <div class="glass-card tech-card">
          <h3>POS Integration</h3>
          <p>{technicalDetails.posIntegration}</p>
        </div>
        <div class="glass-card tech-card">
          <h3>Apps</h3>
          <p>{technicalDetails.apps}</p>
        </div>
        <div class="glass-card tech-card">
          <h3>Privacy</h3>
          <p>{technicalDetails.dataPrivacy}</p>
        </div>
      </div>
      <p style="margin-top:1.5rem; text-align:center;">
        <a href="/how-it-works/" class="btn btn--glass">Full technical guide →</a>
      </p>
    </div>
  </section>

  <section class="section section--sm">
    <div class="container">
      <CaseStudies studies={caseStudies} />
    </div>
  </section>

  <section class="section section--sm">
    <div class="container reveal" style="text-align:center;">
      <AppCta class="btn btn--primary btn--lg">Start 14-Day Free Trial</AppCta>
      <p style="margin-top:1rem; color:var(--text-muted);">Contact: {SITE.email}</p>
      <p style="margin-top:1.25rem;">
        <a href="/g2/" class="btn btn--glass">Scan Perks on G2 →</a>
      </p>
    </div>
  </section>

  <Footer />
</BaseLayout>

<style>
  .stats-row {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
    margin-top: 2rem;
  }

  .stats-row__item {
    text-align: center;
    padding: 1.25rem;
    background: rgba(255, 255, 255, 0.03);
    border-radius: var(--radius-sm);
    border: 1px solid var(--glass-border);
  }

  .stats-row__item strong {
    display: block;
    font-size: 1.5rem;
    color: var(--cyan-400);
    margin-bottom: 0.25rem;
  }

  .stats-row__item span {
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  .tech-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.25rem;
  }

  .tech-card {
    padding: 1.5rem;
  }

  .tech-card h3 {
    font-size: 1rem;
    font-weight: 700;
    color: var(--blue-300);
    margin-bottom: 0.75rem;
  }

  .tech-card p {
    font-size: 0.9rem;
    color: var(--text-secondary);
    line-height: 1.65;
  }

  @media (max-width: 768px) {
    .stats-row { grid-template-columns: repeat(2, 1fr); }
    .tech-grid { grid-template-columns: 1fr; }
  }
</style>
