---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import AlternativePage from '../components/AlternativePage.astro';
import BusinessTypePage from '../components/BusinessTypePage.astro';
import LoyaltyLandingPage from '../components/LoyaltyLandingPage.astro';
import LocalizedLanding from '../components/LocalizedLanding.astro';
import { alternativeMeta, alternativePages, getAlternative } from '../data/alternatives';
import { businessTypeMeta, businessTypePages, getBusinessType } from '../data/businessTypes';
import { getLoyaltyPage, getAllLandingSlugs } from '../data/loyaltyPages';
import { getCanonicalOverrideForSlug } from '../data/seoCanonicals';
import { buildLoyaltyServiceSchema, buildHowToSchema } from '../seo/schema';
import { enNicheSlugPaths, findDefByEnSlug, getHreflangLinks } from '../i18n/pages';
import { phrases } from '../data/site-facts';

export function getStaticPaths() {
  const loyalty = getAllLandingSlugs().map((slug) => ({
    params: { slug },
    props: { kind: 'loyalty' as const },
  }));
  const existing = new Set(getAllLandingSlugs());
  const businessSlugs = new Set(businessTypePages.map((item) => item.slug));
  const niches = enNicheSlugPaths()
    .filter(({ slug }) => !existing.has(slug) && !businessSlugs.has(slug))
    .map(({ slug }) => ({
      params: { slug },
      props: { kind: 'niche' as const },
    }));
  const alternatives = alternativePages.map((item) => ({
    params: { slug: item.slug },
    props: { kind: 'alternative' as const },
  }));
  const businessTypes = businessTypePages.map((item) => ({
    params: { slug: item.slug },
    props: { kind: 'business-type' as const },
  }));
  return [...loyalty, ...niches, ...alternatives, ...businessTypes];
}

const { slug } = Astro.params;
const kind = Astro.props.kind as 'loyalty' | 'niche' | 'alternative' | 'business-type';

const nicheDef = kind === 'niche' ? findDefByEnSlug(slug!) : undefined;
const nicheContent = nicheDef?.content.en;

const page = kind === 'loyalty' ? getLoyaltyPage(slug!) : undefined;
const alternative = kind === 'alternative' ? getAlternative(slug!) : undefined;
const businessType = kind === 'business-type' ? getBusinessType(slug!) : undefined;
if (kind === 'loyalty' && !page) return Astro.redirect('/404');
if (kind === 'niche' && !nicheDef) return Astro.redirect('/404');
if (kind === 'alternative' && !alternative) return Astro.redirect('/404');
if (kind === 'business-type' && !businessType) return Astro.redirect('/404');

const allFaqs = page ? page.faqs : nicheContent?.faqs ?? [];

const path = alternative
  ? `/${alternative.slug}/`
  : businessType
    ? `/${businessType.slug}/`
    : page
      ? `/${page.slug}/`
      : `/${nicheContent!.slug}/`;
const canonicalOverride = page ? getCanonicalOverrideForSlug(page.slug) : undefined;
const servicePath = canonicalOverride ?? path;

const i18nDef = nicheDef ?? (canonicalOverride ? undefined : findDefByEnSlug(page?.slug ?? ''));
const hreflangLinks = canonicalOverride ? [] : i18nDef ? getHreflangLinks(i18nDef) : undefined;

const serviceSchema = page
  ? buildLoyaltyServiceSchema({
      name: page.title,
      description: page.description,
      path: servicePath,
      keyword: page.primaryKeyword,
    })
  : null;

const cafeHowTo =
  page && (page.slug === 'cafe-loyalty-app' || page.slug === 'qr-code-loyalty-program')
    ? buildHowToSchema({
        name:
          page.slug === 'cafe-loyalty-app'
            ? 'How to set up a cafe loyalty app with a counter QR'
            : 'How to start a QR code loyalty program',
        description:
          'Print a counter QR. Customers scan it in the free Scan Perks app. About 5 minutes, no POS.',
        steps: [
          { name: 'Create account', text: `Sign up at app.scan-perks.com and start the ${phrases.en.trial}.` },
          { name: 'Set stamp rules', text: 'Choose a reward such as 8 stamps for a free coffee.' },
          { name: 'Print your QR', text: 'Tap Create my QR, print it, and put it by the till.' },
          {
            name: 'Customers scan in the app',
            text: 'Guests open the free Scan Perks app (iPhone or Android), tap Scan, and point it at the poster. A phone camera opens your venue page with an app link.',
          },
        ],
      })
    : null;

const pubHowTo =
  page && (page.slug === 'pub-loyalty-card' || page.slug === 'pub-loyalty-scheme')
    ? buildHowToSchema({
        name:
          page.slug === 'pub-loyalty-card'
            ? 'How to launch a digital pub loyalty card'
            : 'How to launch a pub loyalty scheme',
        description:
          'Set up QR pub loyalty for an independent pub or bar in about 5 minutes — no POS required.',
        steps: [
          { name: 'Create account', text: `Sign up at app.scan-perks.com and start the ${phrases.en.trial}.` },
          { name: 'Set reward tiers', text: 'Choose stamp rules such as 10 drinks = 1 free pint.' },
          { name: 'Print your bar QR', text: 'Download the print-ready QR poster and display it at the bar.' },
          {
            name: 'Guests scan & earn',
            text: 'Customers scan the bar QR in the free Scan Perks app and collect stamps on a digital pub loyalty card.',
          },
        ],
      })
    : null;

const loyaltyExtraSchema = [serviceSchema, pubHowTo, cafeHowTo].filter(Boolean) as Record<string, unknown>[];
const altMeta = alternative ? alternativeMeta(alternative) : undefined;
const businessMeta = businessType ? businessTypeMeta(businessType) : undefined;
const businessNiche = businessType ? findDefByEnSlug(businessType.slug) : undefined;
---

{businessType && businessMeta ? (
  <BaseLayout
    title={businessMeta.title}
    description={businessMeta.description}
    path={path}
    lang="en"
    hreflangLinks={businessNiche ? getHreflangLinks(businessNiche) : undefined}
    faqs={businessType.faqs}
    breadcrumbs={[
      { name: 'Home', path: '/' },
      { name: businessType.heading, path },
    ]}
  >
    <Nav />
    <BusinessTypePage page={businessType} />
    <Footer />
  </BaseLayout>
) : alternative && altMeta ? (
  <BaseLayout
    title={altMeta.title}
    description={altMeta.description}
    path={path}
    lang="en"
    breadcrumbs={[
      { name: 'Home', path: '/' },
      { name: altMeta.heading, path },
    ]}
  >
    <Nav />
    <AlternativePage page={alternative} />
    <Footer />
  </BaseLayout>
) : nicheDef && nicheContent ? (
  <BaseLayout
    title={nicheContent.metaTitle}
    description={nicheContent.description}
    path={path}
    lang="en"
    hreflangLinks={hreflangLinks}
    faqs={nicheContent.faqs}
    breadcrumbs={[
      { name: 'Home', path: '/' },
      { name: nicheContent.h1, path },
    ]}
  >
    <Nav />
    <LocalizedLanding locale="en" content={nicheContent} />
    <Footer />
  </BaseLayout>
) : page ? (
  <BaseLayout
    title={page.metaTitle}
    description={page.description}
    path={path}
    canonicalPath={canonicalOverride}
    lang="en"
    hreflangLinks={hreflangLinks}
    faqs={allFaqs}
    breadcrumbs={[
      { name: 'Home', path: '/' },
      { name: page.title, path: servicePath },
    ]}
    extraSchema={loyaltyExtraSchema}
    noindex={Boolean(canonicalOverride)}
  >
    <Nav />
    {canonicalOverride && (
      <div class="canonical-banner">
        <div class="container">
          <p>
            Looking for the main guide?
            <a href={canonicalOverride}>Continue to the primary page →</a>
          </p>
        </div>
      </div>
    )}
    <LoyaltyLandingPage page={page} faqs={allFaqs} />
    <Footer />
  </BaseLayout>
) : null}

<style>
  .canonical-banner {
    padding: 0.75rem 0;
    background: rgba(34, 211, 238, 0.08);
    border-bottom: 1px solid rgba(34, 211, 238, 0.25);
    text-align: center;
    font-size: 0.9rem;
    color: var(--text-secondary);
  }

  .canonical-banner a {
    color: var(--cyan-400);
    font-weight: 600;
    margin-left: 0.35rem;
  }
</style>
