---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import AppCta from '../../components/AppCta.astro';
import FAQSection from '../../components/FAQSection.astro';
import InternalLinks from '../../components/InternalLinks.astro';
import AnswerFirst from '../../components/AnswerFirst.astro';
import FeatureBulletList from '../../components/FeatureBulletList.astro';
import Hero from '../../components/Hero.astro';
import Icon from '../../components/Icon.astro';
import CTASection from '../../components/CTASection.astro';
import { featuresSeo } from '../../data/pageSeo';
import { featuresFaqs } from '../../data/conversationalFaqs';
import { scanPerksFeatureList } from '../../data/geoContent';
import { getHreflangLinks, getPageDef } from '../../i18n/pages';
import { phrases } from '../../data/site-facts';
---

<BaseLayout
  title={featuresSeo.title}
  description={featuresSeo.description}
  path="/features/"
  lang="en"
  hreflangLinks={getHreflangLinks(getPageDef('features')!)}
  faqs={featuresFaqs}
  breadcrumbs={[{ name: 'Home', path: '/' }, { name: 'Features', path: '/features/' }]}
>
  <Nav active="features" pageId="features" />

  <Hero>
    <span class="section__label">Features</span>
    <h1 class="page-hero__title">{featuresSeo.h1}</h1>
    <p class="page-hero__seo-line">{featuresSeo.heroSeoLine}</p>
    <p class="page-hero__desc">{featuresSeo.heroDesc}</p>
    <div class="hero__actions hero__actions--center">
      <AppCta class="btn btn--primary btn--lg">Start free trial</AppCta>
      <a href="/pricing/" class="btn btn--glass btn--lg">See Pricing ({phrases.en.starterPerMo})</a>
    </div>
  </Hero>

  <section class="section section--sm">
    <div class="container">
      <AnswerFirst answer={featuresSeo.directAnswer} />
      <FeatureBulletList title="Core Features" items={scanPerksFeatureList} />
    </div>
  </section>

  <InternalLinks />

  <section class="section">
    <div class="container">
      <div class="features-grid">
        <div class="glass-card reveal">
          <div class="feature-card__icon"><Icon name="phone" /></div>
          <h2 class="feature-card__title">QR Code Loyalty Program</h2>
          <p class="feature-card__desc">Full QR code loyalty program with digital QR loyalty card for customers. <a href="/qr-code-loyalty-program/">QR code loyalty program guide →</a></p>
        </div>
        <div class="glass-card reveal">
          <div class="feature-card__icon"><Icon name="coffee" /></div>
          <h2 class="feature-card__title">Cafe Loyalty App</h2>
          <p class="feature-card__desc">Coffee shop loyalty reward app with stamp rewards and counter QR. <a href="/cafe-loyalty-app/">Cafe loyalty app →</a></p>
        </div>
        <div class="glass-card reveal">
          <div class="feature-card__icon"><Icon name="beer" /></div>
          <h2 class="feature-card__title">Bar Loyalty Programs</h2>
          <p class="feature-card__desc">Pub loyalty scheme tools, happy-hour pushes, regular tracking. <a href="/bar-loyalty-program/">Bar loyalty programs →</a></p>
        </div>
        <div class="glass-card reveal">
          <div class="feature-card__icon"><Icon name="chart" /></div>
          <h2 class="feature-card__title">Real-Time Analytics</h2>
          <p class="feature-card__desc">Track visits, rewards redeemed, and loyalty trends from app.scan-perks.com.</p>
        </div>
        <div class="glass-card reveal">
          <div class="feature-card__icon"><Icon name="bell" /></div>
          <h2 class="feature-card__title">Push Notifications</h2>
          <p class="feature-card__desc">Send happy hour deals and special offers instantly to loyal customers.</p>
        </div>
        <div class="glass-card reveal">
          <div class="feature-card__icon"><Icon name="pin" /></div>
          <h2 class="feature-card__title">Local Discovery</h2>
          <p class="feature-card__desc">Get discovered by customers browsing the app for new venues.</p>
        </div>
      </div>
    </div>
  </section>

  <FAQSection faqs={featuresFaqs} title="Features FAQ" />

  <CTASection
    title={`Launch in 5 Minutes — First ${phrases.en.trialDaysCap} Free`}
    description={`Start a ${phrases.en.trial} at app.scan-perks.com — ${phrases.en.noCard} needed.`}
  >
    <AppCta class="btn btn--primary btn--lg">Start free trial</AppCta>
  </CTASection>

  <Footer />
</BaseLayout>
