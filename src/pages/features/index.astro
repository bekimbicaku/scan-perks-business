---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import AppCta from '../../components/AppCta.astro';
import FAQSection from '../../components/FAQSection.astro';
import InternalLinks from '../../components/InternalLinks.astro';
import AnswerFirst from '../../components/AnswerFirst.astro';
import FeatureBulletList from '../../components/FeatureBulletList.astro';
import { featuresSeo } from '../../data/pageSeo';
import { featuresFaqs } from '../../data/conversationalFaqs';
import { scanPerksFeatureList } from '../../data/geoContent';
import { buildSoftwareApplicationSchema } from '../../seo/schema';
---

<BaseLayout
  title={featuresSeo.title}
  description={featuresSeo.description}
  path="/features/"
  keywords={['qr code loyalty program', 'cafe loyalty app', 'bar loyalty programs', 'coffee shop loyalty reward app']}
  faqs={featuresFaqs}
  breadcrumbs={[{ name: 'Home', path: '/' }, { name: 'Features', path: '/features/' }]}
  extraSchema={[buildSoftwareApplicationSchema()]}
>
  <Nav active="features" />

  <section class="page-hero">
    <div class="container reveal">
      <span class="section__label">Features</span>
      <h1 class="page-hero__title">{featuresSeo.h1}</h1>
      <p class="page-hero__seo-line">{featuresSeo.heroSeoLine}</p>
      <p class="page-hero__desc">{featuresSeo.heroDesc}</p>
      <div class="hero__actions" style="justify-content:center; margin-top:1.5rem;">
        <AppCta class="btn btn--primary btn--lg">Start Free — 14 Days</AppCta>
        <a href="/pricing/" class="btn btn--glass btn--lg">See Pricing ($10/mo)</a>
      </div>
    </div>
  </section>

  <section class="section section--sm">
    <div class="container">
      <AnswerFirst answer={featuresSeo.directAnswer} />
      <FeatureBulletList title="Core Features" items={scanPerksFeatureList} />
    </div>
  </section>

  <InternalLinks />

  <section class="section">
    <div class="container">
      <div class="features-grid">
        <div class="glass-card reveal">
          <div class="feature-card__icon">📱</div>
          <h2 class="feature-card__title">QR Code Loyalty Program</h2>
          <p class="feature-card__desc">Full QR code loyalty program with digital QR loyalty card for customers. <a href="/qr-loyalty-program/">QR code loyalty program guide →</a></p>
        </div>
        <div class="glass-card reveal">
          <div class="feature-card__icon">☕</div>
          <h2 class="feature-card__title">Cafe Loyalty App</h2>
          <p class="feature-card__desc">Coffee shop loyalty reward app with stamp rewards and counter QR. <a href="/cafe-loyalty-program/">Cafe loyalty app →</a></p>
        </div>
        <div class="glass-card reveal">
          <div class="feature-card__icon">🍺</div>
          <h2 class="feature-card__title">Bar Loyalty Programs</h2>
          <p class="feature-card__desc">Pub loyalty scheme tools, happy-hour pushes, regular tracking. <a href="/bar-loyalty-program/">Bar loyalty programs →</a></p>
        </div>
        <div class="glass-card reveal">
          <div class="feature-card__icon">📊</div>
          <h2 class="feature-card__title">Real-Time Analytics</h2>
          <p class="feature-card__desc">Track visits, rewards redeemed, and loyalty trends — see up to 24% more repeat visits.</p>
        </div>
        <div class="glass-card reveal">
          <div class="feature-card__icon">🔔</div>
          <h2 class="feature-card__title">Push Notifications</h2>
          <p class="feature-card__desc">Send happy hour deals and special offers instantly to loyal customers.</p>
        </div>
        <div class="glass-card reveal">
          <div class="feature-card__icon">📍</div>
          <h2 class="feature-card__title">Local Discovery</h2>
          <p class="feature-card__desc">Get discovered by customers browsing the app for new venues.</p>
        </div>
      </div>
    </div>
  </section>

  <FAQSection faqs={featuresFaqs} title="Features FAQ" />

  <section class="section section--sm">
    <div class="container reveal">
      <div class="cta-banner">
        <h2 class="cta-banner__title">Launch in 5 Minutes — First 14 Days Free</h2>
        <p class="cta-banner__desc">Join venues reporting 24% more repeat visits. Start at app.scan-perks.com.</p>
        <AppCta class="btn btn--primary btn--lg">Start Free Trial</AppCta>
      </div>
    </div>
  </section>

  <Footer />
</BaseLayout>

<style>
  .page-hero__seo-line {
    font-size: 1.05rem;
    color: var(--blue-300);
    max-width: 560px;
    margin: 0 auto 1rem;
    line-height: 1.6;
    font-weight: 500;
  }
</style>
