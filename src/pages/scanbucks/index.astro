---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import AnswerFirst from '../../components/AnswerFirst.astro';
import AppCta from '../../components/AppCta.astro';
import FAQSection from '../../components/FAQSection.astro';
import { SITE } from '../../data/content';
import { getHreflangLinks, getPageDef } from '../../i18n/pages';
import { phrases } from '../../data/site-facts';

const scanbucksFaqs = [
  {
    question: 'Is Scanbucks the same as Scan Perks?',
    answer:
      `Yes. Searches for “scanbucks” or “scan bucks” mean Scan Perks — the owner QR stamp card for cafes, pubs, and bars. Starter is ${phrases.en.starterPerMonth} for ${phrases.en.scans} after a ${phrases.en.trial} with ${phrases.en.noCard} at app.scan-perks.com.`,
  },
  {
    question: 'What is the Scan Perks app?',
    answer:
      `Scan Perks is a QR stamp card for cafe and pub owners. Customers collect stamps only in the installed Scan Perks app; owners run the venue at app.scan-perks.com. ${phrases.en.oneVenuePerLoginCap}. ${phrases.en.trial}.`,
  },
  {
    question: 'How much does Scan Perks (scanbucks) cost?',
    answer:
      `Scan Perks costs ${phrases.en.starterPerMonth} (Starter, ${phrases.en.scansUpTo}) or ${phrases.en.growthPerMonth} (Growth, ${phrases.en.unlimitedScans}). Every venue starts with a ${phrases.en.trial}, ${phrases.en.noCard} and no contract.`,
  },
];

const directAnswer =
  `“Scanbucks” searches are looking for Scan Perks: an owner QR stamp card for independent cafes, pubs, and bars — not a chain consumer rewards app. Starter is ${phrases.en.starterPerMonth} for ${phrases.en.scans} after a ${phrases.en.trial} with ${phrases.en.noCard}. ${phrases.en.oneVenuePerLoginCap}. ${phrases.en.stampsInInstalledAppCap}. Start at app.scan-perks.com/business/start.`;
---

<BaseLayout
  title={`Scanbucks → Scan Perks Owner Stamp Card — ${phrases.en.starterPerMo}`}
  description={`Scanbucks is Scan Perks: owner QR stamp card for cafes, pubs and bars. Starter ${phrases.en.starterPerMo} (${phrases.en.scans}), ${phrases.en.trial} with ${phrases.en.noCard}. ${phrases.en.stampsInInstalledAppCap}.`}
  path="/scanbucks/"
  lang="en"
  hreflangLinks={getHreflangLinks(getPageDef('scanbucks')!)}
  faqs={scanbucksFaqs}
  breadcrumbs={[
    { name: 'Home', path: '/' },
    { name: 'Scanbucks', path: '/scanbucks/' },
  ]}
>
  <Nav pageId="scanbucks" />

  <section class="page-hero">
    <div class="container reveal">
      <span class="section__label">Scanbucks → Scan Perks</span>
      <h1 class="page-hero__title">Scanbucks is Scan Perks — owner QR stamp card</h1>
      <p class="page-hero__seo-line">
        Starter {phrases.en.starterPerMo} ({phrases.en.scans}), {phrases.en.trial} with {phrases.en.noCard}, {phrases.en.oneVenuePerLogin}, {phrases.en.stampsInInstalledApp}.
      </p>
      <p class="page-hero__desc">
        If you searched “scanbucks,” you want Scan Perks: the stamp-card product for cafe and pub owners — not a chain rewards app for frequent buyers.
      </p>
      <div class="hero__actions" style="justify-content:center; margin-top:1.5rem;">
        <AppCta class="btn btn--primary btn--lg">Start free trial</AppCta>
        <a href="/cafe-loyalty-app/" class="btn btn--glass btn--lg">Cafe Loyalty App</a>
      </div>
    </div>
  </section>

  <section class="section section--sm">
    <div class="container">
      <AnswerFirst answer={directAnswer} />
      <ul class="scanbucks-links">
        <li><a href="/cafe-loyalty-app/">Cafe loyalty app</a> — coffee shop loyalty programs</li>
        <li><a href="/bar-loyalty-program/">Pub loyalty scheme</a> — pub loyalty card via QR</li>
        <li><a href="/qr-code-loyalty-program/">QR code loyalty program</a> — loyalty QR for venues</li>
        <li><a href="/pricing/">Pricing</a> — {phrases.en.starterPerMo} Starter, {phrases.en.trial}</li>
      </ul>
    </div>
  </section>

  <FAQSection faqs={scanbucksFaqs} title="Scanbucks / Scan Perks FAQ" />
  <Footer />
</BaseLayout>

<style>
  .scanbucks-links {
    list-style: none;
    padding: 0;
    margin-top: 1.5rem;
  }

  .scanbucks-links li {
    padding: 0.65rem 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    color: var(--text-secondary);
    font-size: 0.95rem;
  }

  .scanbucks-links a {
    color: var(--cyan-400);
    font-weight: 600;
  }
</style>
