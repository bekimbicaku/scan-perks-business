---
import { SITE } from '../data/content';
import {
  buildBaseSchema,
  buildFaqSchema,
  buildBreadcrumbSchema,
} from '../seo/schema';
import type { Locale } from '../i18n/config';
import { DEFAULT_LOCALE, LOCALE_META } from '../i18n/config';
import { ogImageForPath } from '../seo/shareImage';

interface Props {
  title: string;
  description: string;
  path?: string;
  canonicalPath?: string;
  lang?: Locale;
  /** Full hreflang alternate list. Pass [] to emit none. */
  hreflangLinks?: { hreflang: string; href: string }[];
  ogImage?: string;
  noindex?: boolean;
  extraSchema?: Record<string, unknown>[];
  breadcrumbs?: { name: string; path: string }[];
  faqs?: { question: string; answer: string }[];
}

const {
  title,
  description,
  path = '/',
  canonicalPath,
  lang = DEFAULT_LOCALE,
  hreflangLinks,
  ogImage,
  noindex = false,
  extraSchema = [],
  breadcrumbs,
  faqs,
} = Astro.props;

const resolvedCanonicalPath = canonicalPath ?? path;
const canonical = `${SITE.url}${resolvedCanonicalPath}`;
const baseSchema = buildBaseSchema({ title, description, path: resolvedCanonicalPath });
const schemas = [...baseSchema, ...extraSchema];

if (breadcrumbs?.length) {
  schemas.push(buildBreadcrumbSchema(breadcrumbs));
}
if (faqs?.length) {
  schemas.push(buildFaqSchema(faqs));
}

const alternates =
  hreflangLinks ??
  [
    { hreflang: lang === 'en' ? 'en' : lang, href: canonical },
    { hreflang: 'x-default', href: canonical },
  ];

const imagePath = ogImage ?? ogImageForPath(resolvedCanonicalPath);
const imageUrl = imagePath.startsWith('http') ? imagePath : `${SITE.url}${imagePath}`;

/** One &amp; in the head. Astro's attribute renderer would emit &#38; instead. */
function attr(value: string): string {
  return value.replace(/&/g, '&amp;').replace(/"/g, '&quot;').replace(/</g, '&lt;');
}

const textMeta = `<title>${attr(title)}</title>
<meta name="description" content="${attr(description)}" />
<meta property="og:title" content="${attr(title)}" />
<meta property="og:description" content="${attr(description)}" />
<meta name="twitter:title" content="${attr(title)}" />
<meta name="twitter:description" content="${attr(description)}" />`;
---

<!DOCTYPE html>
<html lang={LOCALE_META[lang].htmlLang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="google-site-verification" content="w2kB_h7DPf5-MuD9ZDt01idsl0E5rrv0jivaMMzrAVQ" />
  <Fragment set:html={textMeta} />
  <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow, max-snippet:-1, max-image-preview:large'} />
  <link rel="canonical" href={canonical} />
  {alternates.map((a) => (
    <link rel="alternate" hreflang={a.hreflang} href={a.href} />
  ))}

  <meta property="og:type" content="website" />
  <meta property="og:locale" content={lang === 'en' ? 'en_US' : LOCALE_META[lang].htmlLang} />
  {lang === 'en' && <meta property="og:locale:alternate" content="en_GB" />}
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={imageUrl} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:type" content="image/png" />
  <meta property="og:site_name" content={SITE.name} />

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:image" content={imageUrl} />

  <link rel="icon" type="image/png" href="/favicon.png" />
  <link rel="preload" href="/fonts/outfit-latin.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="stylesheet" href="/css/styles.css" />

  {schemas.map((schema) => (
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  ))}
</head>
<body>
  <div class="bg-canvas">
    <div class="bg-orb bg-orb--1"></div>
    <div class="bg-orb bg-orb--2"></div>
    <div class="bg-orb bg-orb--3"></div>
    <div class="bg-grid"></div>
  </div>

  <slot />

  <script src="/js/main.js" defer></script>
</body>
</html>
