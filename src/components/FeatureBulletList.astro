---
interface Props {
  items: readonly string[] | string[];
  title?: string;
  ordered?: boolean;
}

const { items, title, ordered = false } = Astro.props;
const Tag = ordered ? 'ol' : 'ul';
---

{title && <h2 class="feature-list__title">{title}</h2>}
<Tag class={`feature-list ${ordered ? 'feature-list--ordered' : ''}`}>
  {items.map((item) => (
    <li>{item}</li>
  ))}
</Tag>

<style>
  .feature-list__title {
    font-size: 1.35rem;
    font-weight: 700;
    margin-bottom: 1rem;
    color: var(--white);
  }

  .feature-list {
    list-style: none;
    padding: 0;
    margin: 0 0 1.5rem;
  }

  .feature-list li {
    position: relative;
    padding: 0.5rem 0 0.5rem 1.5rem;
    color: var(--text-secondary);
    line-height: 1.6;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
  }

  .feature-list li::before {
    content: '✓';
    position: absolute;
    left: 0;
    color: var(--cyan-400);
    font-weight: 700;
  }

  .feature-list--ordered {
    counter-reset: feature-step;
  }

  .feature-list--ordered li::before {
    content: counter(feature-step);
    counter-increment: feature-step;
    width: 1.25rem;
    height: 1.25rem;
    border-radius: 50%;
    background: rgba(34, 211, 238, 0.15);
    font-size: 0.75rem;
    display: flex;
    align-items: center;
    justify-content: center;
    top: 0.55rem;
  }
</style>
