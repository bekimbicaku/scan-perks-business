---
interface Props {
  faqs: { question: string; answer: string }[];
  title?: string;
}

const { faqs, title = 'Frequently Asked Questions' } = Astro.props;
const baseId = title.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '') || 'faq';
---

<section class="section section--sm" id="faq">
  <div class="container">
    <div class="section__header reveal">
      <span class="section__label">FAQ</span>
      <h2 class="section__title">{title}</h2>
    </div>
    <div class="faq-list reveal">
      {faqs.map((faq, i) => (
        <div class="faq-item">
          <button
            class="faq-item__question"
            type="button"
            id={`${baseId}-q-${i}`}
            aria-expanded="false"
            aria-controls={`${baseId}-a-${i}`}
          >
            {faq.question}
          </button>
          <div class="faq-item__answer" id={`${baseId}-a-${i}`} role="region" aria-labelledby={`${baseId}-q-${i}`}>
            <p>{faq.answer}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
