---
/** Exact-match hub — pub pages first (GSC: closest to top 10) */
const links = [
  { href: '/pub-loyalty-card/', keyword: 'Pub Loyalty Card', desc: 'Closest to top 10 — digital QR card' },
  { href: '/pub-loyalty-scheme/', keyword: 'Pub Loyalty Scheme', desc: 'UK pubs & US bars — from $10/mo' },
  { href: '/bar-loyalty-program/', keyword: 'Bar Loyalty Programs', desc: 'US bars — happy-hour pushes' },
  { href: '/cafe-loyalty-app/', keyword: 'Cafe Loyalty App', desc: 'Primary cafe URL — camera QR, no download' },
  { href: '/qr-code-loyalty-program/', keyword: 'QR Code Loyalty Program', desc: 'Loyalty QR — setup in 5 minutes' },
  { href: '/pricing/', keyword: 'Pricing — $10/mo', desc: '14-day free trial' },
  { href: '/faq/', keyword: 'Loyalty FAQ', desc: 'Answers for cafe & pub owners' },
  { href: '/g2/', keyword: 'Scan Perks on G2', desc: 'Reviews & product profile' },
];
---

<section class="section section--sm seo-keyword-hub">
  <div class="container">
    <div class="section__header reveal">
      <span class="section__label">Top Searches</span>
      <h2 class="section__title">Pub, Bar &amp; Cafe Loyalty</h2>
      <p class="section__subtitle">Start with the pages closest to Google’s top 10 — from $10/month with a 14-day free trial.</p>
    </div>
    <nav class="seo-keyword-hub__grid" aria-label="Top loyalty program pages">
      {links.map((link) => (
        <a href={link.href} class="glass-card seo-keyword-hub__card reveal">
          <strong>{link.keyword}</strong>
          <span>{link.desc}</span>
        </a>
      ))}
    </nav>
  </div>
</section>

<style>
  .seo-keyword-hub__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
  }

  .seo-keyword-hub__card {
    display: block;
    padding: 1.15rem;
    transition: var(--transition);
  }

  .seo-keyword-hub__card:hover {
    border-color: rgba(59, 130, 246, 0.4);
    transform: translateY(-2px);
  }

  .seo-keyword-hub__card strong {
    display: block;
    color: var(--blue-300);
    font-size: 0.92rem;
    margin-bottom: 0.3rem;
    line-height: 1.35;
  }

  .seo-keyword-hub__card span {
    font-size: 0.78rem;
    color: var(--text-secondary);
    line-height: 1.4;
  }

  @media (max-width: 1024px) {
    .seo-keyword-hub__grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 768px) {
    .seo-keyword-hub__grid { grid-template-columns: 1fr; }
  }
</style>
