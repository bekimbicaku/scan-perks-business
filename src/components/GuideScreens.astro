---
import {
  guideScreens,
  type GuideScreenId,
} from '../data/guideScreens';
import { DEFAULT_LOCALE, type Locale } from '../i18n/config';
import { getGuideScreenCopy } from '../i18n/guideScreenCopy';

interface Props {
  ids: GuideScreenId[];
  title: string;
  intro?: string;
  labelledBy?: string;
  locale?: Locale;
}

const {
  ids,
  title,
  intro,
  labelledBy = 'guide-screens-title',
  locale = DEFAULT_LOCALE,
} = Astro.props;
const screens = ids.map((id) => {
  const screen = guideScreens[id];
  const copy = getGuideScreenCopy(id, locale);
  return { ...screen, ...copy };
});
---

<section class="section section--sm" aria-labelledby={labelledBy}>
  <div class="container reveal">
    <div class="section__header">
      <h2 id={labelledBy} class="section__title" style="font-size:1.75rem;">{title}</h2>
      {intro && <p class="guide-screens__intro">{intro}</p>}
    </div>
    <div class="guide-screens">
      {screens.map((screen) => (
        <figure class="guide-screens__item">
          <div class="guide-screens__frame">
            <img
              src={screen.src}
              alt={screen.alt}
              width={screen.width}
              height={screen.height}
              loading="lazy"
              decoding="async"
            />
          </div>
          <figcaption class="guide-screens__caption">
            <strong>{screen.title}</strong>
            <span>{screen.caption}</span>
          </figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>

<style>
  .guide-screens__intro {
    color: var(--text-secondary);
    max-width: 640px;
    margin: 0.5rem auto 0;
    line-height: 1.6;
  }

  .guide-screens {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1.5rem 1.25rem;
    margin-top: 1.75rem;
    align-items: start;
  }

  .guide-screens__item {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .guide-screens__frame {
    margin: 0 auto;
    width: min(100%, 240px);
    padding: 0.55rem;
    border-radius: 22px;
    border: 1px solid var(--glass-border);
    background: rgba(255, 255, 255, 0.03);
    box-shadow: 0 18px 40px rgba(0, 0, 0, 0.28);
  }

  .guide-screens__frame img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 16px;
  }

  .guide-screens__caption {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    text-align: center;
    font-size: 0.9rem;
    line-height: 1.5;
    color: var(--text-secondary);
  }

  .guide-screens__caption strong {
    color: #fff;
    font-size: 1rem;
  }

  @media (max-width: 1100px) {
    .guide-screens {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 560px) {
    .guide-screens {
      grid-template-columns: minmax(0, 1fr);
      justify-items: center;
    }

    .guide-screens__item {
      max-width: 280px;
    }
  }
</style>
