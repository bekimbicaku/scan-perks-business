---
import type { LoyaltyPage } from '../data/loyaltyPages';
import { blogArticles } from '../data/blogArticles';
import { directAnswers } from '../data/geoContent';
import FAQSection from './FAQSection.astro';
import AppCta from './AppCta.astro';
import AnswerFirst from './AnswerFirst.astro';
import FeatureBulletList from './FeatureBulletList.astro';
import InternalLinks from './InternalLinks.astro';
import NamedVendorTable from './NamedVendorTable.astro';
import Hero from './Hero.astro';
import ComparisonTable from './ComparisonTable.astro';
import CTASection from './CTASection.astro';
import { SITE, appSignupUrl } from '../data/content';
import { phrases } from '../data/site-facts';

interface Props {
  page: LoyaltyPage;
  faqs?: { question: string; answer: string }[];
}

const { page, faqs = page.faqs } = Astro.props;
const posts = blogArticles.filter((a) => page.supportingPosts.includes(a.slug));

const slugToAnswer: Record<string, string> = {
  'cafe-loyalty-program': directAnswers.cafe,
  'cafe-loyalty-app': directAnswers.cafe,
  'coffee-loyalty-app': directAnswers.cafe,
  'coffee-shop-loyalty-app': directAnswers.cafe,
  'coffee-shop-loyalty-programs': directAnswers.cafe,
  'qr-loyalty-program': directAnswers.qr,
  'qr-code-loyalty-program': directAnswers.qr,
  'bar-loyalty-program': directAnswers.bar,
  'pub-loyalty-scheme': directAnswers.bar,
  'pub-loyalty-card': directAnswers.bar,
};
const namedVendorSlugs = new Set([
  'cafe-loyalty-app',
  'qr-code-loyalty-program',
  'pub-loyalty-scheme',
  'pub-loyalty-card',
  'coffee-shop-loyalty-programs',
]);
const showNamedVendors = namedVendorSlugs.has(page.slug);
const directAnswer = page.quickAnswer ?? slugToAnswer[page.slug];
---

<article>
  <Hero>
    <span class="section__label">{page.primaryKeyword}</span>
    <h1 class="page-hero__title">{page.title}</h1>
    {page.heroSeoLine && <p class="page-hero__seo-line">{page.heroSeoLine}</p>}
    <p class="page-hero__desc">{page.description}</p>
    <div class="hero__actions hero__actions--center">
      <AppCta class="btn btn--primary btn--lg" position="hero">Start free trial</AppCta>
      <AppCta class="btn btn--glass btn--lg" position="hero-customer">Get the Rewards App</AppCta>
    </div>
    <p class="page-hero__note">
      Customers: free. Owners: {phrases.en.trialShort} · No POS · From {phrases.en.starterPerMo}
    </p>
  </Hero>

  {directAnswer && (
    <section class="section section--sm">
      <div class="container">
        <AnswerFirst answer={directAnswer} />
      </div>
    </section>
  )}

  {page.highlights.length > 0 && (
    <section class="section section--sm">
      <div class="container">
        <div class="features-grid" style="grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));">
          {page.highlights.map((h) => (
            <div class="glass-card reveal" style="text-align:center; padding:1.25rem;">
              <p style="font-weight:600; color:var(--blue-300);">{h}</p>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="section section--sm">
    <div class="container">
      {page.sections.map((section) => (
        <div class="glass-card reveal" style="margin-bottom:1.5rem;">
          <h2 class="feature-card__title" style="font-size:1.35rem; margin-bottom:0.75rem;">{section.heading}</h2>
          <p class="feature-card__desc" style="font-size:1rem;">{section.body}</p>
          {section.links && (
            <p style="margin-top:0.75rem;">
              {section.links.map((l, i) => (
                <>
                  {i > 0 && ' · '}
                  <a href={l.href.startsWith(SITE.appWebUrl) ? appSignupUrl(Astro.url.pathname, 'section-link') : l.href} style="color:var(--cyan-400); font-weight:600;">{l.label} →</a>
                </>
              ))}
            </p>
          )}
        </div>
      ))}
      {page.featureBullets && page.featureBullets.length > 0 && (
        <FeatureBulletList title="Key capabilities" items={page.featureBullets} />
      )}
    </div>
  </section>

  {page.localMarkets && (
    <section class="section section--sm">
      <div class="container reveal">
        <div class="section__header">
          <h2 class="section__title" style="font-size:1.75rem;">Perfect For</h2>
        </div>
        <div class="features-grid" style="grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));">
          {page.localMarkets.map((m) => (
            <div class="glass-card" style="text-align:center; padding:1rem;">{m}</div>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="section section--sm">
    <div class="container reveal">
      <div class="section__header">
        <h2 class="section__title" style="font-size:1.75rem;">Scan Perks vs Alternatives</h2>
      </div>
      {showNamedVendors ? (
        <NamedVendorTable />
      ) : (
        <ComparisonTable
          columns={[
            { key: 'feature', label: 'Feature' },
            { key: 'scanPerks', label: 'Scan Perks', highlight: true },
            { key: 'traditional', label: 'Punch Cards' },
            { key: 'enterprise', label: 'Enterprise' },
          ]}
          rows={page.comparison}
        />
      )}
    </div>
  </section>

  {posts.length > 0 && (
    <section class="section section--sm">
      <div class="container">
        <div class="section__header reveal">
          <h2 class="section__title" style="font-size:1.75rem;">Related Guides</h2>
        </div>
        <div class="features-grid">
          {posts.map((post) => (
            <a href={`/blog/${post.slug}/`} class="glass-card reveal" style="display:block;">
              <h3 class="feature-card__title">{post.title}</h3>
              <p class="feature-card__desc">{post.description}</p>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <InternalLinks />

  <FAQSection faqs={faqs} title={`${page.title} FAQ`} />

  <CTASection
    title={`Start Your ${page.title} Today`}
    description={`${phrases.en.trial}. No contracts. Grow loyal customers from ${phrases.en.starterPerMonth}.`}
  >
    <AppCta class="btn btn--primary btn--lg" position="bottom">Start free trial</AppCta>
  </CTASection>

  <nav class="section section--sm" aria-label="Related loyalty programs">
    <div class="container">
      <p style="text-align:center; color:var(--text-muted); font-size:0.9rem;">
        Also see: <a href="/pub-loyalty-card/" style="color:var(--blue-300);">Pub Loyalty Card</a>
        {' · '}
        <a href="/pub-loyalty-scheme/" style="color:var(--blue-300);">Pub Loyalty Scheme</a>
        {' · '}
        <a href="/cafe-loyalty-app/" style="color:var(--blue-300);">Cafe Loyalty App</a>
        {' · '}
        <a href="/qr-code-loyalty-program/" style="color:var(--blue-300);">QR Code Loyalty</a>
      </p>
    </div>
  </nav>
</article>
