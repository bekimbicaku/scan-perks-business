---
interface Props {
  items?: readonly string[];
}

const { items } = Astro.props;
---

{items ? (
  <ol class="step-list step-list--plain">
    {items.map((text, i) => (
      <li>
        <span class="step-list__num">{i + 1}</span>
        <span>{text}</span>
      </li>
    ))}
  </ol>
) : (
  <div class="step-list">
    <slot />
  </div>
)}

<style>
  .step-list {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-5);
  }

  .step-list--plain {
    display: block;
    list-style: none;
    padding: var(--space-8);
    max-width: 40rem;
    margin: 0 auto;
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border);
    background: var(--color-surface-strong);
    box-shadow: var(--shadow-sm);
  }

  .step-list--plain li {
    display: flex;
    align-items: flex-start;
    gap: var(--space-4);
    padding: var(--space-3) 0;
    color: var(--color-text-secondary);
    line-height: var(--leading-body);
    border-bottom: 1px solid var(--color-border);
  }

  .step-list--plain li:last-child {
    border-bottom: 0;
  }

  .step-list--plain .step-list__num {
    flex-shrink: 0;
    display: inline-flex;
    width: 2rem;
    height: 2rem;
    align-items: center;
    justify-content: center;
    margin-bottom: 0;
    border-radius: var(--radius-full);
    background: var(--color-action);
    color: var(--white);
    font-weight: var(--weight-black);
    font-size: var(--text-sm);
  }

  @media (max-width: 900px) {
    .step-list {
      grid-template-columns: 1fr;
    }
  }
</style>
