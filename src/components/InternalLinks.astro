---
/** Priority internal links — pub pages first (closest to top 10 in GSC) */
---

<section class="section section--sm internal-links">
  <div class="container">
    <p class="internal-links__label">Closest to top 10 — link these</p>
    <nav class="internal-links__grid" aria-label="Loyalty program pages">
      <a href="/pub-loyalty-card/" class="glass-card internal-links__card">
        <strong>Pub Loyalty Card</strong>
        <span>#1 ranking opportunity — digital QR card</span>
      </a>
      <a href="/pub-loyalty-scheme/" class="glass-card internal-links__card">
        <strong>Pub Loyalty Scheme</strong>
        <span>UK pubs &amp; US bars from $10/mo</span>
      </a>
      <a href="/bar-loyalty-program/" class="glass-card internal-links__card">
        <strong>Bar Loyalty Programs</strong>
        <span>US bars — happy-hour pushes</span>
      </a>
      <a href="/cafe-loyalty-app/" class="glass-card internal-links__card">
        <strong>Cafe Loyalty App</strong>
        <span>Coffee shop owners — camera QR, no download</span>
      </a>
      <a href="/qr-code-loyalty-program/" class="glass-card internal-links__card">
        <strong>QR Code Loyalty Program</strong>
        <span>Loyalty QR — live in 5 min</span>
      </a>
      <a href="/pricing/" class="glass-card internal-links__card">
        <strong>$10/mo — Free Trial</strong>
        <span>14 days, no contract</span>
      </a>
    </nav>
  </div>
</section>

<style>
  .internal-links__label {
    text-align: center;
    font-size: 0.8rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-muted);
    margin-bottom: 1.25rem;
  }

  .internal-links__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }

  .internal-links__card {
    display: block;
    padding: 1.25rem;
    transition: var(--transition);
  }

  .internal-links__card strong {
    display: block;
    color: var(--blue-300);
    font-size: 0.95rem;
    margin-bottom: 0.35rem;
  }

  .internal-links__card span {
    font-size: 0.8rem;
    color: var(--text-secondary);
    line-height: 1.4;
  }

  @media (max-width: 768px) {
    .internal-links__grid { grid-template-columns: 1fr; }
  }
</style>
