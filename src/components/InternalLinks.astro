---
import { alternativePages } from '../data/alternatives';
import { phrases } from '../data/site-facts';
/** Priority internal links for high-impression owner pages — no orphan URL spam. */
---

<section class="section section--sm internal-links">
  <div class="container">
    <p class="internal-links__label">Loyalty guides for owners</p>
    <nav class="internal-links__grid" aria-label="Loyalty program pages">
      <a href="/cafe-loyalty-app/" class="glass-card internal-links__card">
        <strong>Cafe Loyalty App</strong>
        <span>Coffee shop owners — counter QR stamp card</span>
      </a>
      <a href="/coffee-shop-loyalty-programs/" class="glass-card internal-links__card">
        <strong>Coffee Shop Loyalty Programs</strong>
        <span>Owner stamp programs — not chain rewards lists</span>
      </a>
      <a href="/pub-loyalty-card/" class="glass-card internal-links__card">
        <strong>Pub Loyalty Card</strong>
        <span>Replace paper stamp cards — UK pubs</span>
      </a>
      <a href="/pub-loyalty-scheme/" class="glass-card internal-links__card">
        <strong>Pub Loyalty Scheme</strong>
        <span>UK pubs &amp; US bars — happy-hour double stamps</span>
      </a>
      <a href="/bar-loyalty-program/" class="glass-card internal-links__card">
        <strong>Bar Loyalty Programs</strong>
        <span>US bars — QR stamp card for regulars</span>
      </a>
      <a href="/how-it-works/" class="glass-card internal-links__card">
        <strong>How It Works</strong>
        <span>Owner QR stamp setup in about 5 minutes</span>
      </a>
      <a href="/pricing/" class="glass-card internal-links__card">
        <strong>Pricing — Starter {phrases.en.starterPerMo}</strong>
        <span>Growth {phrases.en.growthPerMo} · {phrases.en.trialShort}, {phrases.en.noCard}</span>
      </a>
      <a href="/faq/" class="glass-card internal-links__card">
        <strong>Owner FAQ</strong>
        <span>Best loyalty program for cafes — stamp facts</span>
      </a>
      {alternativePages.map((item) => (
        <a href={`/${item.slug}/`} class="glass-card internal-links__card">
          <strong>{item.name} alternative</strong>
          <span>{item.guideLine}</span>
        </a>
      ))}
    </nav>
  </div>
</section>

<style>
  .internal-links__label {
    text-align: center;
    font-size: 0.8rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-muted);
    margin-bottom: 1.25rem;
  }

  .internal-links__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }

  .internal-links__card {
    display: block;
    padding: 1.25rem;
    transition: var(--transition);
  }

  .internal-links__card strong {
    display: block;
    color: var(--blue-300);
    font-size: 0.95rem;
    margin-bottom: 0.35rem;
  }

  .internal-links__card span {
    font-size: 0.8rem;
    color: var(--text-secondary);
    line-height: 1.4;
  }

  @media (max-width: 768px) {
    .internal-links__grid { grid-template-columns: 1fr; }
  }
</style>
