---
import type { ComparisonRow } from '../data/geoContent';
import ComparisonTable from './ComparisonTable.astro';

interface Props {
  rows: ComparisonRow[];
  intro?: string;
  showCompetitor?: boolean;
}

const { rows, intro, showCompetitor = true } = Astro.props;

const columns = [
  { key: 'feature', label: 'Feature' },
  { key: 'scanPerks', label: 'Scan Perks', highlight: true },
  { key: 'punchCards', label: 'Punch Cards' },
  { key: 'enterprise', label: 'Enterprise' },
  ...(showCompetitor ? [{ key: 'competitor', label: 'Typical Competitor' }] : []),
];
---

<ComparisonTable
  columns={columns}
  intro={intro}
  rows={rows.map((row) => ({
    feature: row.feature,
    scanPerks: row.scanPerks,
    punchCards: row.punchCards,
    enterprise: row.enterprise,
    competitor: row.competitor ?? '—',
  }))}
/>
