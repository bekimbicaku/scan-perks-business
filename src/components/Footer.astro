---
import { SITE } from '../data/content';
import { G2_LISTING } from '../data/g2AndOutreach';
---

<footer class="footer">
  <div class="container">
    <div class="footer__grid">
      <div class="footer__brand">
        <div class="footer__logo">
          <img src="/favicon.png" alt="Scan Perks" width="36" height="36" />
          Scan Perks
        </div>
        <p>QR loyalty for cafes, pubs & restaurants — from $10/month.</p>
        <p style="margin-top:0.75rem;">
          <a href={SITE.appWebUrl} style="color:var(--cyan-400);font-weight:600;">
            Open app.scan-perks.com →
          </a>
        </p>
      </div>
      <div>
        <h4 class="footer__heading">Loyalty Programs</h4>
        <ul class="footer__links">
          <li><a href="/pub-loyalty-card/">Pub Loyalty Card</a></li>
          <li><a href="/pub-loyalty-scheme/">Pub Loyalty Scheme</a></li>
          <li><a href="/cafe-loyalty-app/">Cafe Loyalty App</a></li>
          <li><a href="/coffee-shop-loyalty-programs/">Coffee Shop Loyalty</a></li>
          <li><a href="/qr-code-loyalty-program/">QR Code Loyalty</a></li>
          <li><a href="/bar-loyalty-program/">Bar Loyalty Programs</a></li>
          <li><a href="/restaurant-loyalty-program/">Restaurant Loyalty</a></li>
          <li><a href="/business-loyalty-program/">Business Loyalty Guide</a></li>
        </ul>
      </div>
      <div>
        <h4 class="footer__heading">Product</h4>
        <ul class="footer__links">
          <li><a href="/features/">Features</a></li>
          <li><a href="/pricing/">Pricing</a></li>
          <li><a href="/how-it-works/">How It Works</a></li>
          <li><a href="/faq/">FAQ</a></li>
          <li><a href="/scanbucks/">Scanbucks</a></li>
          <li><a href="/blog/">Blog</a></li>
          <li><a href={SITE.playStore} rel="noopener noreferrer">Google Play</a></li>
          <li><a href={SITE.appStore} rel="noopener noreferrer">App Store</a></li>
        </ul>
      </div>
      <div>
        <h4 class="footer__heading">Company</h4>
        <ul class="footer__links">
          <li><a href="/about/">About Us</a></li>
          <li><a href="/contact/">Contact</a></li>
          <li><a href="/g2/">G2 Profile</a></li>
          <li>
            <a href={G2_LISTING.profileUrl || SITE.social.g2} rel="noopener noreferrer" target="_blank">
              Leave a G2 Review
            </a>
          </li>
        </ul>
      </div>
    </div>
    <div class="footer__bottom">
      <span>&copy; {new Date().getFullYear()} Scan Perks. All rights reserved.</span>
      <div class="footer__socials">
        <a href={SITE.social.twitter} aria-label="Twitter" rel="noopener noreferrer">𝕏</a>
        <a href={SITE.social.instagram} aria-label="Instagram" rel="noopener noreferrer">IG</a>
        <a href={SITE.social.linkedin} aria-label="LinkedIn" rel="noopener noreferrer">in</a>
      </div>
    </div>
  </div>
</footer>
