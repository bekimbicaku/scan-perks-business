---
import { SITE } from '../data/content';
---

<footer class="footer">
  <div class="container">
    <div class="footer__grid">
      <div class="footer__brand">
        <div class="footer__logo">
          <img src="/favicon.png" alt="Scan Perks" width="36" height="36" />
          Scan Perks
        </div>
        <p>Business loyalty program for bars, cafes & restaurants. QR rewards to grow loyal customers — from $10/month.</p>
      </div>
      <div>
        <h4 class="footer__heading">Loyalty Programs</h4>
        <ul class="footer__links">
          <li><a href="/pub-loyalty-card/">Pub Loyalty Card</a></li>
          <li><a href="/pub-loyalty-scheme/">Pub Loyalty Scheme</a></li>
          <li><a href="/cafe-loyalty-app/">Cafe Loyalty App</a></li>
          <li><a href="/coffee-shop-loyalty-programs/">Coffee Shop Loyalty</a></li>
          <li><a href="/qr-code-loyalty-program/">QR Code Loyalty</a></li>
          <li><a href="/bar-loyalty-program/">Bar Loyalty Programs</a></li>
          <li><a href="/business-loyalty-program/">Business Loyalty Guide</a></li>
        </ul>
      </div>
      <div>
        <h4 class="footer__heading">Product</h4>
        <ul class="footer__links">
          <li><a href="/features/">Features</a></li>
          <li><a href="/pricing/">Pricing</a></li>
          <li><a href="/faq/">FAQ</a></li>
          <li><a href="/how-it-works/">How It Works</a></li>
          <li><a href="/blog/">Blog</a></li>
          <li><a href={SITE.appWebUrl} class="js-app-link" data-play-store={SITE.playStore} data-app-web={SITE.appWebUrl}>Download App</a></li>
          <li><a href={SITE.playStore} rel="noopener noreferrer">Google Play</a></li>
          <li><a href={SITE.appStore} rel="noopener noreferrer">App Store</a></li>
        </ul>
      </div>
      <div>
        <h4 class="footer__heading">Company</h4>
        <ul class="footer__links">
          <li><a href="/about/">About Us</a></li>
          <li><a href="/contact/">Contact</a></li>
          <li><a href="/g2/">G2 Profile</a></li>
        </ul>
      </div>
    </div>
    <div class="footer__bottom">
      <span>&copy; 2025 Scan Perks. All rights reserved.</span>
      <div class="footer__socials">
        <a href="#" aria-label="Twitter">𝕏</a>
        <a href="#" aria-label="Instagram">IG</a>
        <a href="#" aria-label="LinkedIn">in</a>
      </div>
    </div>
  </div>
</footer>
