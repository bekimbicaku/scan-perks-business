---
import { appSignupUrl } from '../data/content';

interface Props {
  class?: string;
  /** Button position, sent as utm_content. */
  position?: string;
}

const { class: className = 'btn btn--primary', position = 'cta' } = Astro.props;
const label = (await Astro.slots.render('default')).replace(/\s+/g, ' ').trim();
const appPath = label === 'Start free trial' ? '/business/start' : '/';
const href = appSignupUrl(Astro.url.pathname, position, appPath);
---

<a href={href} class={className} set:html={label} />
