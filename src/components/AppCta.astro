---
import { appSignupUrl } from '../data/content';

interface Props {
  class?: string;
  /** Button position, sent as utm_content. */
  position?: string;
}

const { class: className = 'btn btn--primary', position = 'cta' } = Astro.props;
---

<a href={appSignupUrl(Astro.url.pathname, position)} class={className}>
  <slot />
</a>
