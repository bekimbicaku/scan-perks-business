{
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.scan-perks.com" }],
      "destination": "https://scan-perks.com/:path*",
      "permanent": true
    },
    {
      "source": "/cafe-loyalty-program",
      "destination": "/cafe-loyalty-app/",
      "permanent": true
    },
    {
      "source": "/cafe-loyalty-program/",
      "destination": "/cafe-loyalty-app/",
      "permanent": true
    },
    {
      "source": "/qr-loyalty-program",
      "destination": "/qr-code-loyalty-program/",
      "permanent": true
    },
    {
      "source": "/qr-loyalty-program/",
      "destination": "/qr-code-loyalty-program/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; media-src 'self'; connect-src 'self' https://formsubmit.co; form-action 'self' https://formsubmit.co"
        }
      ]
    }
  ]
}
